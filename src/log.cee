// A stock access log: a line a request on standard output.
import web_core;
import web_http;

/// Writes `GET /users/7 200 153us` for each request (with ` trace=…` behind the `Trace` filter), the query left out (it may hold what should not be kept). A
/// line is one write, so several workers' lines do not mix; each costs a system call, which a server that answers
/// a hundred thousand requests a second will notice.
public struct ConsoleLog {}

/// ` trace=<id>` appended to `line`, if the scope has a trace.
fn traced(line: borrow mut Vector<u8>, scope: borrow Scope) -> bool {
    let id = scope.value("trace") ?? { return true; };
    return put(line, " trace=".bytes()) && put(line, id);
}

impl AccessLog for ConsoleLog {
    async fn record(
        borrow this,
        request: borrow Request,
        scope: borrow Scope,
        status: u16,
        micros: u64,
    ) {
        var line = Vector<u8>.create();
        let ok = put(mut line, Methods.text(request.method()).bytes()) &&
            put(mut line, " ".bytes()) &&
            put(mut line, request.path().bytes()) &&
            put(mut line, " ".bytes()) &&
            putDecimal(mut line, status as u64) &&
            put(mut line, " ".bytes()) &&
            putDecimal(mut line, micros) &&
            put(mut line, "us".bytes()) &&
            traced(mut line, scope);
        if (!ok) {
            return;
        }
        // A path that is not UTF-8 is not written.
        let text = StringView.fromUtf8(line.view()) ?? { return; };
        let _ = await AsyncConsole.writeLine(text);
    }

    /// Writes `GET /users/7 crashed index` for a request whose handler trapped (Web ADR 0017).
    async fn crashed(borrow this, request: borrow Request, crash: borrow TaskCrash) {
        var line = Vector<u8>.create();
        let ok = put(mut line, Methods.text(request.method()).bytes()) &&
            put(mut line, " ".bytes()) &&
            put(mut line, request.path().bytes()) &&
            put(mut line, " crashed ".bytes()) &&
            put(mut line, kindName(crash.kind()).bytes());
        if (!ok) {
            return;
        }
        let text = StringView.fromUtf8(line.view()) ?? { return; };
        let _ = await AsyncConsole.writeLine(text);
    }
}

/// The panic's kind, as the access log writes it.
fn kindName(kind: PanicKind) -> StringView => match (kind) {
    PanicKind.Overflow => "overflow",
    PanicKind.DivideByZero => "divide-by-zero",
    PanicKind.Shift => "shift",
    PanicKind.Unreachable => "unreachable",
    PanicKind.Index => "index",
    PanicKind.Slice => "slice",
    PanicKind.Unwrap => "unwrap",
    PanicKind.Scratch => "scratch",
    PanicKind.UnwrapNull => "unwrap-null",
    PanicKind.StringBoundary => "string-boundary",
    PanicKind.ForeignEnum => "foreign-enum",
    PanicKind.Length => "length",
    PanicKind.FloatRange => "float-range",
    PanicKind.Explicit => "panic",
    PanicKind.Poisoned => "poisoned",
    PanicKind.Overran => "overran",
    PanicKind.Other => "other",
};
