// The supervisor: a parent process that keeps a number of worker processes running, each serving the same port.
//
// A CeeSafe trap (an index out of bounds, an overflow, a failed assertion) outside an isolated task ends its process:
// there is no unwinding. So what a request must not be able to take down is put in a process of its own. Each worker
// is a process with its own memory, one event loop and one core; the parent does nothing but watch them:
//
// - a worker that ends, however it ends, is started again (after a growing pause if it keeps ending at once);
// - a worker whose isolated tasks' crashes passed the bound asks to be replaced: another is started in its place at
//   once, and the old one drains (docs/elixir-gaps.md §4), so a recycle refuses no connection;
// - a worker that stops beating (its event loop is stuck in a computation) is killed and started again;
// - a worker may be given a memory limit, so that one that grows without bound fails its own allocations;
// - SIGTERM or SIGINT to the parent is passed to the workers, which drain and end; those that have not after the
//   grace are killed.
//
// A worker is the same program started again (`Process.spawnWith`, ceesafec ADR 0173), not a copy of the parent: it
// runs `main` from the start, makes the same `Supervisor`, and is told by its last argument which worker it is. What
// the workers share, the parent makes through the supervisor and hands to each (`Handover`): a page of memory where
// each worker writes its beat, the program's shared words and bus, and the listening socket. A worker takes them
// back in the order the parent made them, which is the order the program asks for them, since it runs the same code.
import web_core;
import web_transport;

@header("sys/resource.h")
extern "C" {
    const RLIMIT_AS: i32;

    struct rlimit {
        rlim_cur: u64;
        rlim_max: u64;
    }

    @effects()
    fn setrlimit(resource: i32, limit: *rlimit) -> i32;
}

/// The most workers a supervisor runs: what fits the page of beats.
public fn maxWorkers() -> u32 => 256;

/// The argument a worker is started with, before its index and generation: `--httpserver-worker=3.1`. It is the
/// last one. A place has two generations, 0 and 1, so that a worker started in the place of one that drains has
/// words and a ring of the bus of its own.
fn workerFlag() -> StringView => "--httpserver-worker=";

/// What a supervisor is told.
public struct SupervisorOptions {
    /// How many worker processes (1 to `maxWorkers()`): as a rule, one a core.
    public workers: u32;
    /// A worker that has not beaten for this long is killed and started again; 0 for no such watch. It must be
    /// several times what the worker's `tend` beats at.
    public stallMs: u64;
    /// After a request to stop, how long the workers have to drain before they are killed.
    public graceMs: u64;
    /// Each worker's address-space limit in bytes (`RLIMIT_AS`), so that a worker that grows fails its own
    /// allocations and not the machine's; 0 for none. Linux enforces it; macOS does not.
    public memoryBytes: u64;
    /// Whether to say on standard output when a worker starts, ends or is killed.
    public log: bool;
    /// Under `App.runIsolated`, a worker whose isolated tasks have trapped this many times drains and ends, and is
    /// started again (`tend` watches `Isolation.report()`): each crash leaks what its connection held, its socket
    /// among it. 0 for no such bound.
    public recycleCrashes: u64;
    /// The same for the bytes the crashes leaked. 0 for no such bound.
    public recycleLeakedBytes: u64;

    /// `workers` workers, a 5 s watch, a 10 s grace, no memory limit, the log, and a worker replaced after 100
    /// crashes or 64 MiB leaked by them.
    public fn defaults(workers: u32) -> SupervisorOptions => SupervisorOptions {
        workers: workers,
        stallMs: 5000,
        graceMs: 10000,
        memoryBytes: 0,
        log: true,
        recycleCrashes: 100,
        recycleLeakedBytes: 64 * 1048576,
    };
}

/// What happened while the supervisor ran.
public struct SupervisorReport {
    /// Workers started, the first of each place included.
    public started: u64;
    /// Workers started in the place of one that drained because its isolated tasks' crashes passed the bound.
    public recycled: u64;
    /// Workers that ended with a status other than 0, or by a signal that was not the supervisor's.
    public crashed: u64;
    /// Workers killed because they stopped beating.
    public stalled: u64;
    /// Workers killed because they outlived the grace.
    public killed: u64;
}

/// Why a supervisor could not run.
public enum SupervisorError {
    /// `workers` is 0 or more than `maxWorkers()`.
    BadOptions,
    /// The system gave no shared memory.
    NoSharedMemory,
    /// The parent could not list something for its workers: more than 16 things, or the system refused.
    CannotHand,
    /// A worker was not handed what the program asks for, in that order: the program made its shared things in
    /// another order in the worker than in the parent, or the worker was started by something else.
    NotHanded,
    /// The listening socket could not be bound.
    CannotListen,
    /// The first worker could not be started (`Process.spawnWith` failed).
    CannotStart,
    /// The supervisor could not watch the process's signals, or its loop could not run.
    CannotWatch,
}

/// A worker's place: which of the workers it is, and where it beats.
public struct Worker {
    private place: u32;
    /// Its generation in the place, 0 or 1 (`workerFlag`).
    private generation: u32;
    /// The address of its word of the page of beats; 0 without a supervisor.
    private slot: usize;
    /// The address of its word of the page of states: 0, 1 when it asks to be replaced, 2 when the parent tells it to
    /// drain. 0 without a supervisor.
    private state: usize;
    /// `SupervisorOptions.recycleCrashes` and `recycleLeakedBytes`; 0 for none.
    private crashLimit: u64;
    private leakLimit: u64;

    /// A worker without a supervisor: the whole server in one process. Its beat goes nowhere, and it is never
    /// recycled.
    public fn alone() -> Worker => Worker { place: 0, generation: 0, slot: 0, state: 0, crashLimit: 0, leakLimit: 0 };

    /// Whether the isolated tasks of this process have cost it more than the supervisor allows: then it should drain
    /// and end, to be started again.
    public fn spent(borrow this) -> bool {
        if (this.crashLimit == 0 && this.leakLimit == 0) {
            return false;
        }
        let report = Isolation.report();
        return (this.crashLimit != 0 && report.crashes >= this.crashLimit) ||
            (this.leakLimit != 0 && report.leakedBytes >= this.leakLimit);
    }

    /// Which worker this is: 0 to the count less one. A worker started in the place of one that drains has its index.
    public fn index(borrow this) -> u32 => this.place;

    /// Its ring of the supervisor's bus (`Bus.join`, `BusCarrier`): two for each place, one for each generation, so
    /// a worker and the one started in its place while it drains each write a ring of their own.
    public fn ring(borrow this) -> u32 => this.place * 2 + this.generation;

    /// Its word of the page of states.
    /// Safety: `state` is this worker's word of the page the supervisor handed it, mapped for the life of the
    /// process, aligned, and only ever accessed atomically, here and by the parent.
    fn stateWord(borrow this) -> borrow AtomicU64 => unsafe { Ptr.toBorrow(this.state as *mut AtomicU64) };

    /// Asks the supervisor for a worker in this one's place (`tend`, once `spent`).
    fn askToBeReplaced(borrow this) {
        if (this.state != 0) {
            this.stateWord().store(1);
        }
    }

    /// Whether the supervisor told this worker to drain: its replacement is started, and where the workers bind
    /// sockets of their own, has beaten.
    fn released(borrow this) -> bool => this.state == 0 || this.stateWord().load() == 2;

    /// Whether a supervisor watches this worker.
    public fn supervised(borrow this) -> bool => this.slot != 0;

    /// Tells the supervisor this worker's event loop is turning.
    /// Safety: the slot is this worker's word of the page the supervisor handed it, which stays mapped for the life
    /// of the process; only this worker writes it, and the parent reads it whole (an aligned 64-bit word).
    public fn beat(borrow this) {
        if (this.slot != 0) {
            let word = this.slot as *mut u64;
            unsafe { word.write(word.read() + 1); }
        }
    }
}

/// What a worker process does: the program's server.
public interface WorkerMain {
    /// Runs the worker (`Async.run` of its server) and returns the status the process exits with. It should end
    /// when asked to (`tend` starts the drain on SIGTERM).
    fn run(borrow this, worker: Worker) -> i32;
}

/// A listening socket the supervisor made: the one the parent bound, which every worker accepts from. It is the
/// server's `Incoming`. Connections waiting to be accepted outlive a worker that ends, and on macOS, where the
/// kernel gives every connection on a port bound by several processes to one of them, this is how the workers
/// share the load.
public struct SharedListener {
    private listener: AsyncTcpListener;

    /// The port it listens on.
    public fn port(borrow this) -> Result<u16, NetError> {
        match (this.listener.port()) {
            Ok(p) => { return Ok(p); }
            Err(e) => { return Err(NetErrors.fromIo(e)); }
        }
    }
}

impl Incoming for SharedListener {
    /// The next connection, with TCP_NODELAY on as web_transport's `Listener` sets it.
    async fn next(borrow this) -> Result<PlainStream, NetError> {
        match (await this.listener.accept()) {
            Ok(s) => {
                let t = TcpTransport.fromStream(s);
                match (t.setNoDelay(true)) {
                    Ok() => {}
                    Err(_) => {} // the peer already left: the connection's first read or write says so
                }
                return Ok(PlainStream.tcp(t));
            }
            Err(e) => { return Err(NetErrors.fromAsync(e)); }
        }
    }
}

/// The supervisor of a program's workers. In the parent it makes what the workers share and starts them; in a
/// worker (the same program, started by the parent) it takes back what it was handed and runs the worker.
///
/// ```
/// var supervisor = Supervisor.create(SupervisorOptions.defaults(4))?;
/// let words = supervisor.words(4096)?;                 // the same calls, in the same order, in every process
/// let listener = supervisor.listener(address, options)?;
/// supervisor.run(Server { words: words, listener: listener })   // in a worker, never returns
/// ```
@noncopy
public struct Supervisor {
    private options: SupervisorOptions;
    /// In a worker: which one. Null in the parent.
    private me: u32?;
    /// In a worker: its generation in its place (0 or 1).
    private generation: u32;
    /// The pages of beats and states: their address. Beats first, a word for each place and generation, then the
    /// states, as many.
    private beats: usize;
    /// In the parent: whether it bound the listening socket the workers accept from (`listener`).
    private shared: bool;
    /// What the parent hands each worker (empty in a worker).
    private handover: Handover;
    /// What a worker was handed (empty in the parent).
    private given: Inherited;
    /// The next place of the handover: what the next shared thing is in both.
    private next: u32;

    /// The supervisor of this process: the parent's, or, in a process the parent started, that worker's.
    public fn create(options: SupervisorOptions) -> Result<Supervisor, SupervisorError> {
        if (options.workers == 0 || options.workers > maxWorkers()) {
            return Err(SupervisorError.BadOptions);
        }
        let seat = workerSeat();
        var supervisor = Supervisor {
            options: options,
            me: match (seat) {
                Some(s) => Some(s / 2),
                null => null,
            },
            generation: (seat ?? 0) % 2,
            beats: 0,
            shared: false,
            handover: Handover.create(),
            given: Process.inherited(),
            next: 0,
        };
        match (supervisor.me) {
            Some(i) => {
                if (i >= options.workers) {
                    return Err(SupervisorError.NotHanded);
                }
            }
            null => {}
        }
        supervisor.beats = supervisor.memory(maxWorkers() as usize * 32)?;
        return Ok(supervisor);
    }

    /// Which worker this process is; null in the parent.
    public fn worker(borrow this) -> u32? => this.me;

    /// The next shared memory of at least `bytes` bytes: made and listed in the parent, taken in a worker. Its
    /// address; it stays mapped for the life of the process.
    fn memory(borrow mut this, bytes: usize) -> Result<usize, SupervisorError> {
        let place = this.next;
        this.next += 1;
        match (this.me) {
            Some(_) => {
                match (this.given.kind(place)) {
                    Some(InheritedKind.Memory) => {}
                    _ => { return Err(SupervisorError.NotHanded); }
                }
                let memory = match (this.given.memory(place)) {
                    Ok(m) => m,
                    Err(_) => { return Err(SupervisorError.NotHanded); },
                };
                if (memory.length() < bytes) {
                    return Err(SupervisorError.NotHanded);
                }
                return Ok(kept(memory) ?? { return Err(SupervisorError.NoSharedMemory); });
            }
            null => {
                let memory = match (SharedMemory.anonymous(bytes)) {
                    Ok(m) => m,
                    Err(_) => { return Err(SupervisorError.NoSharedMemory); },
                };
                match (this.handover.memory(memory)) {
                    Ok(at) => {
                        if (at != place) {
                            return Err(SupervisorError.CannotHand);
                        }
                    }
                    Err(_) => { return Err(SupervisorError.CannotHand); }
                }
                return Ok(kept(memory) ?? { return Err(SupervisorError.NoSharedMemory); });
            }
        }
    }

    /// `count` words every worker shares (`SharedWords.create`'s rounding).
    public fn words(borrow mut this, count: usize) -> Result<SharedWords, SupervisorError> {
        let size = SharedWords.sizeFor(count);
        let base = this.memory(size * 8)?;
        return Ok(SharedWords.at(base, size));
    }

    /// The workers' bus, rings of `ringBytes` each (`Bus.create`'s rounding).
    public fn bus(borrow mut this, ringBytes: usize) -> Result<Bus, SupervisorError> {
        // Two rings for each place: a worker and the one started in its place while it drains (`Worker.ring`).
        let size = Bus.ringFor(ringBytes);
        let base = this.memory(Bus.bytesFor(this.options.workers * 2, size))?;
        return Ok(Bus.at(base, this.options.workers * 2, size));
    }

    /// The listening socket every worker accepts from: bound in the parent, with `options`, and taken in a worker.
    public fn listener(
        borrow mut this,
        address: SocketAddress,
        options: ListenOptions,
    ) -> Result<SharedListener, SupervisorError> {
        let place = this.next;
        this.next += 1;
        match (this.me) {
            Some(_) => {
                match (this.given.kind(place)) {
                    Some(InheritedKind.Listener) => {}
                    _ => { return Err(SupervisorError.NotHanded); }
                }
                match (this.given.listener(place)) {
                    Ok(l) => { return Ok(SharedListener { listener: l }); }
                    Err(_) => { return Err(SupervisorError.NotHanded); }
                }
            }
            null => {
                let listener = match (AsyncTcpListener.bindWith(address, options)) {
                    Ok(l) => l,
                    Err(_) => { return Err(SupervisorError.CannotListen); },
                };
                match (this.handover.listener(listener)) {
                    Ok(at) => {
                        if (at != place) {
                            return Err(SupervisorError.CannotHand);
                        }
                    }
                    Err(_) => { return Err(SupervisorError.CannotHand); }
                }
                this.shared = true;
                return Ok(SharedListener { listener: listener });
            }
        }
    }

    /// In a worker, runs `main` and ends the process with its status: it never returns. In the parent, runs
    /// `options.workers` workers until the supervisor is asked to stop (SIGTERM or SIGINT) and the workers have
    /// ended.
    /// Safety: `setrlimit` reads two `u64`, which is `struct rlimit` on LP64; the pages hold a beat and a state for
    /// each of `maxWorkers()` places and two generations, so the worker's words are inside them.
    public fn run<M: WorkerMain>(this, main: borrow M) -> Result<SupervisorReport, SupervisorError> {
        match (this.me) {
            Some(i) => {
                if (this.options.memoryBytes != 0) {
                    var limit = [this.options.memoryBytes; 2];
                    unsafe { setrlimit(RLIMIT_AS, borrow limit[0] as *u64 as *rlimit); }
                }
                let seat = (i * 2 + this.generation) as usize;
                Process.exit(main.run(Worker {
                    place: i,
                    generation: this.generation,
                    slot: beatAt(this.beats, seat),
                    state: stateAt(this.beats, seat),
                    crashLimit: this.options.recycleCrashes,
                    leakLimit: this.options.recycleLeakedBytes,
                }));
            }
            null => {}
        }
        let signals = match (ProcessSignals.subscribe()) {
            Ok(s) => s,
            Err(_) => { return Err(SupervisorError.CannotWatch); },
        };
        // Asked here: the path is read from the system, which may block.
        let program = match (Process.executable()) {
            Ok(p) => p,
            Err(_) => { return Err(SupervisorError.CannotStart); },
        };
        return Async.run(
            watch(this.options, this.beats, this.shared, program.view(), borrow this.handover, borrow signals),
        );
    }
}

/// The worker's seat, its index times two plus its generation, from its last argument (`--httpserver-worker=3.1`;
/// `3` alone is generation 0); null in a process that was not started as a worker.
fn workerSeat() -> u32? {
    let count = Process.argumentCount();
    if (count < 2) {
        return null;
    }
    let last = Process.argument(count - 1) ?? { return null; };
    let flag = workerFlag();
    if (!last.startsWith(flag)) {
        return null;
    }
    let digits = last.bytes();
    var end = digits.length;
    var generation: u32 = 0;
    if (end >= flag.length + 2 && digits[end - 2] == 46) {
        // `.0` or `.1`
        let g = digits[end - 1];
        if (g != 48 && g != 49) {
            return null;
        }
        generation = (g - 48) as u32;
        end -= 2;
    }
    if (end == flag.length || end > flag.length + 3) {
        return null;
    }
    var n: u32 = 0;
    for (i in flag.length..end) {
        let d = digits[i];
        if (d < 48 || d > 57) {
            return null;
        }
        n = n * 10 + (d - 48) as u32;
    }
    return Some(n * 2 + generation);
}

/// A worker's process as the parent sees it.
struct Place {
    /// Its generation: which of the place's two seats it beats in.
    generation: u32;
    startedMs: u64;
    /// The beat last seen, and when it last changed.
    beat: u64;
    beatMs: u64;
    /// When to start it again; 0: not waiting.
    restartMs: u64;
    /// How many times in a row it ended within a second of starting.
    quick: u32;
}

fn nowMs() -> u64 => Clock.monotonicNanos() / 1000000;

/// The seat of place `i`'s generation `generation`: its index in each page.
fn seatOf(i: usize, generation: u32) -> usize => i * 2 + generation as usize;

/// The address of a seat's beat, and of its state.
fn beatAt(beats: usize, seat: usize) -> usize => beats + seat * 8;
fn stateAt(beats: usize, seat: usize) -> usize => beats + (maxWorkers() as usize * 2 + seat) * 8;

/// A seat's beat.
/// Safety: the pages hold `maxWorkers()` places of two seats, mapped for the life of the process; the callers pass
/// a seat of a place below the count of workers. A beat is an aligned word only its worker writes.
fn beatOf(beats: usize, seat: usize) -> u64 => unsafe { (beatAt(beats, seat) as *u64).read() };

/// Sets a seat's beat and state to 0, before a worker is started in it.
/// Safety: as beatOf; no worker runs in the seat.
fn clearSeat(beats: usize, seat: usize) {
    unsafe { (beatAt(beats, seat) as *mut u64).write(0); }
    stateStore(beats, seat, 0);
}

/// A seat's state: 1 when its worker asks to be replaced, 2 once it is told to drain.
/// Safety: as beatOf; a state is only ever accessed atomically, here and by its worker.
fn stateLoad(beats: usize, seat: usize) -> u64 =>
    unsafe { Ptr.toBorrow(stateAt(beats, seat) as *mut AtomicU64).load() };

/// Safety: as stateLoad.
fn stateStore(beats: usize, seat: usize, value: u64) {
    unsafe { Ptr.toBorrow(stateAt(beats, seat) as *mut AtomicU64).store(value); }
}

/// One line on standard output: `supervisor: worker <index> (pid <pid>) <what> <number>`.
async fn say(options: borrow SupervisorOptions, index: usize, pid: u64, what: StringView, number: u64, numbered: bool) {
    if (!options.log) {
        return;
    }
    var buffer = [0u8; 160];
    var w = TextWriter.create(mut buffer[..]);
    w.text("supervisor: worker ");
    w.decimal(index as u64);
    w.text(" (pid ");
    w.decimal(pid);
    w.text(") ");
    w.text(what);
    if (numbered) {
        w.text(" ");
        w.decimal(number);
    }
    match (StringView.fromUtf8(w.written())) {
        Some(line) => {
            let _ = await AsyncConsole.writeLine(line);
        }
        null => {}
    }
}

/// Starts worker `index` in its generation `generation`: this program again, with its arguments and the worker's.
fn start(
    program: StringView,
    index: usize,
    generation: u32,
    handover: borrow Handover,
) -> Result<ChildProcess, IoError> {
    var flag = [0u8; 40];
    var w = TextWriter.create(mut flag[..]);
    w.text(workerFlag());
    w.decimal(index as u64);
    w.text(if (generation == 0) ".0" else ".1");
    let mine = StringView.fromUtf8(w.written()) ?? { return Err(IoError.InvalidInput); };
    var arguments = Vector<StringView>.create();
    for (i in 1..Process.argumentCount()) {
        match (Process.argument(i)) {
            Some(a) => {
                if (arguments.push(a).isErr()) {
                    return Err(IoError.OutOfMemory);
                }
            }
            null => { return Err(IoError.InvalidInput); }
        }
    }
    if (arguments.push(mine).isErr()) {
        return Err(IoError.OutOfMemory);
    }
    return Process.spawnWith(program, arguments, ChildOptions.inherit(), handover);
}

/// The parent's loop: starts the workers, watches them, starts one in the place of a worker that asks to be replaced,
/// and passes a request to stop on. Each place has two seats, one for each generation: its worker's, and while that
/// one drains, its replacement's. `shared`: the workers accept from the socket the parent bound, so a worker that asks
/// to be replaced is told to drain at once, its queue being the others'; else it serves on until its replacement
/// has beaten, since what waits in its own socket's queue when it closes it is reset (on Linux, unless
/// `net.ipv4.tcp_migrate_req` is 1).
async fn watch(
    options: SupervisorOptions,
    beats: usize,
    shared: bool,
    program: StringView,
    handover: borrow Handover,
    signals: borrow ProcessSignals,
) -> Result<SupervisorReport, SupervisorError> {
    var report = SupervisorReport { started: 0, recycled: 0, crashed: 0, stalled: 0, killed: 0 };
    let count = options.workers as usize;
    var places = Vector<Place>.create();
    // By seat: a place's worker in the seat of its generation, and one that drains in the other.
    var children = Vector<ChildProcess?>.create();
    // By place: when the worker that drains in the other seat was told to; 0 before. Whether it was killed.
    var toldMs = Vector<u64>.create();
    var retiredKilled = Vector<bool>.create();
    for (i in 0..count) {
        // due at once
        let place = Place { generation: 0, startedMs: 0, beat: 0, beatMs: 0, restartMs: 1, quick: 0 };
        if (places.push(place).isErr() || children.push(null).isErr() || children.push(null).isErr() ||
            toldMs.push(0).isErr() || retiredKilled.push(false).isErr()) {
            return Err(SupervisorError.CannotWatch);
        }
    }
    var stopping = false;
    var stopSentMs: u64 = 0;
    var killSent = false;
    loop {
        let now = nowMs();
        loop {
            let signal = signals.poll() ?? { break; };
            match (signal) {
                ProcessSignal.Interrupt => { stopping = true; }
                ProcessSignal.Terminate => { stopping = true; }
                _ => {}
            }
        }
        // Workers that ended: a place's own, and one that drained in the place of another.
        for (seat in 0..count * 2) {
            let i = seat / 2;
            let current = seat == seatOf(i, places[i].generation);
            var ended: ChildExit? = null;
            var pid: u64 = 0;
            match (borrow mut children[seat]) {
                Some(child) => {
                    pid = child.id();
                    match (child.poll()) {
                        Ok(exit) => { ended = exit; }
                        Err(_) => { ended = Some(ChildExit.Status(-1)); }
                    }
                }
                null => {}
            }
            let exit = ended ?? { continue; };
            children[seat] = null;
            let signalled = match (exit) {
                ChildExit.Signal(_) => true,
                ChildExit.Status(_) => false,
            };
            let code = match (exit) {
                ChildExit.Signal(n) => n,
                ChildExit.Status(n) => n,
            };
            if (!current) {
                if (!stopping && !retiredKilled[i] && (signalled || code != 0)) {
                    report.crashed += 1;
                }
                toldMs[i] = 0;
                retiredKilled[i] = false;
                await say(
                    options,
                    i,
                    pid,
                    if (signalled) "drained, replaced: ended by signal" else "drained, replaced: exited with status",
                    truncate<u64>(code as i64),
                    true,
                );
                continue;
            }
            let asked = stopping || places[i].restartMs != 0; // restartMs is set when the supervisor killed it
            if (!asked && (signalled || code != 0)) {
                report.crashed += 1;
            }
            await say(
                options,
                i,
                pid,
                if (signalled) "ended by signal" else "exited with status",
                truncate<u64>(code as i64),
                true,
            );
            let lived = now - places[i].startedMs;
            if (lived < 1000) {
                places[i].quick += 1;
            } else {
                places[i].quick = 0;
            }
            // 0, 100 ms, 200 ms, ... 3.2 s, then 5 s: a worker that cannot start does not spin the machine.
            let step =
                if (places[i].quick > 6) 5000u64 else (if (places[i].quick == 0) 0u64 else 50u64 << places[i].quick);
            places[i].restartMs = now + step + 1;
        }
        if (stopping) {
            var alive: usize = 0;
            for (seat in 0..count * 2) {
                if (children[seat].isSome()) {
                    alive += 1;
                }
            }
            if (alive == 0) {
                return Ok(report);
            }
            if (stopSentMs == 0) {
                stopSentMs = now;
                for (seat in 0..count * 2) {
                    match (borrow children[seat]) {
                        Some(child) => {
                            let _ = child.terminate();
                        }
                        null => {}
                    }
                }
            } else if (!killSent && now - stopSentMs > options.graceMs) {
                killSent = true;
                for (seat in 0..count * 2) {
                    match (borrow children[seat]) {
                        Some(child) => {
                            report.killed += 1;
                            await say(options, seat / 2, child.id(), "outlived the grace: killed", 0, false);
                            let _ = child.kill();
                        }
                        null => {}
                    }
                }
            }
        } else {
            for (i in 0..count) {
                let seat = seatOf(i, places[i].generation);
                let other = seatOf(i, 1 - places[i].generation);
                if (children[seat].isNull()) {
                    if (places[i].restartMs != 0 && now >= places[i].restartMs) {
                        clearSeat(beats, seat);
                        match (start(program, i, places[i].generation, handover)) {
                            Ok(child) => {
                                report.started += 1;
                                let pid = child.id();
                                children[seat] = Some(child);
                                places[i].startedMs = now;
                                places[i].beat = 0;
                                places[i].beatMs = now;
                                places[i].restartMs = 0;
                                await say(options, i, pid, "started", 0, false);
                            }
                            Err(_) => {
                                if (report.started == 0) {
                                    return Err(SupervisorError.CannotStart);
                                }
                                places[i].restartMs = now + 1000; // the machine is out of processes: try again later
                            }
                        }
                    }
                    continue;
                }
                // A worker that asks to be replaced (`tend`, once `spent`): another in its place at once, in the
                // other seat, while it drains.
                if (children[other].isNull() && places[i].restartMs == 0 && stateLoad(beats, seat) == 1) {
                    let next = 1 - places[i].generation;
                    clearSeat(beats, other);
                    match (start(program, i, next, handover)) {
                        Ok(child) => {
                            report.started += 1;
                            report.recycled += 1;
                            let pid = child.id();
                            children[other] = Some(child);
                            places[i].generation = next;
                            places[i].startedMs = now;
                            places[i].beat = 0;
                            places[i].beatMs = now;
                            toldMs[i] = 0;
                            retiredKilled[i] = false;
                            await say(options, i, pid, "started in the place of one that drains", 0, false);
                            if (shared) {
                                stateStore(beats, seat, 2);
                                toldMs[i] = now;
                            }
                        }
                        Err(_) => {
                            // No process for its replacement: it drains alone, and is started again when it ends.
                            stateStore(beats, seat, 2);
                        }
                    }
                    continue;
                }
                // The worker that drains in the other seat: told to once its replacement has beaten, and killed past
                // the grace.
                match (borrow children[other]) {
                    Some(retiring) => {
                        if (toldMs[i] == 0) {
                            if (beatOf(beats, seat) != 0) {
                                stateStore(beats, other, 2);
                                toldMs[i] = now;
                            }
                        } else if (!retiredKilled[i] && now - toldMs[i] > options.graceMs) {
                            retiredKilled[i] = true;
                            report.killed += 1;
                            await say(options, i, retiring.id(), "drained past the grace: killed", 0, false);
                            let _ = retiring.kill();
                        }
                    }
                    null => {}
                }
                if (options.stallMs == 0 || places[i].restartMs != 0) {
                    continue;
                }
                let beat = beatOf(beats, seat);
                if (beat != places[i].beat) {
                    places[i].beat = beat;
                    places[i].beatMs = now;
                } else if (now - places[i].beatMs > options.stallMs) {
                    report.stalled += 1;
                    match (borrow children[seat]) {
                        Some(child) => {
                            await say(
                                options,
                                i,
                                child.id(),
                                "has not beaten: killed after ms",
                                now - places[i].beatMs,
                                true,
                            );
                            let _ = child.kill();
                        }
                        null => {}
                    }
                    places[i].restartMs = now; // marks it as killed here; the poll above starts it again
                }
            }
        }
        match (await Timer.sleep(20)) {
            Ok() => {}
            Err(_) => { return Err(SupervisorError.CannotWatch); }
        }
    }
}

/// A worker's housekeeping, to race against its server (`Async.race(server, tend<ServerReport>(…))`): beats every
/// `everyMs`, and starts `drain` when the process is asked to stop (SIGTERM or SIGINT). When its isolated tasks have
/// cost it more than the supervisor allows (`Worker.spent`), it asks the supervisor for a worker in its place and
/// starts `drain` when told to: at once where the workers accept from the parent's socket, else once the new one
/// has beaten. So the server finishes what is in flight and returns while another serves; nothing is refused. A
/// worker without a supervisor drains at once. It returns only an error.
public async fn tend<T>(worker: Worker, drain: borrow Drain, everyMs: u64) -> Result<T, NetError> {
    // A subscription that fails (another holds it) leaves the signals to their holder.
    let signals = match (ProcessSignals.subscribe()) {
        Ok(s) => Some(s),
        Err(_) => null,
    };
    var recycling = false;
    var released = false;
    loop {
        worker.beat();
        if (!recycling && worker.spent()) {
            recycling = true;
            if (worker.supervised()) {
                worker.askToBeReplaced();
                let _ = await AsyncConsole.writeLine(
                    "worker: its isolated tasks' crashes passed the bound: asking for a worker in its place",
                );
            }
        }
        if (recycling && !released && worker.released()) {
            released = true;
            let _ = await AsyncConsole.writeLine(
                "worker: its isolated tasks' crashes passed the bound: draining, to be replaced",
            );
            drain.start();
        }
        match (borrow signals) {
            Some(s) => {
                if (s.poll().isSome()) {
                    drain.start();
                }
            }
            null => {}
        }
        match (await Timer.sleep(everyMs)) {
            Ok() => {}
            Err(e) => { return Err(NetErrors.fromAsync(e)); }
        }
    }
}
