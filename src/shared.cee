// Memory the supervisor's workers share: words, each changed atomically.
//
// It is ceesafec's `SharedMemory` with no name (`SharedMemory.anonymous`, ADR 0173): the supervisor makes it in the
// parent and hands it to each worker it starts (`Supervisor.words`), so nothing else finds it, and a supervisor that
// is killed leaves nothing behind. Only words go in it: no locks, no pointers, nothing that is allocated. A worker
// that traps half way through a change has then changed one word or not, and cannot leave the others something
// half written to trust or a lock nobody will release.
import web_core;

/// The address of `memory`, which stays mapped for the life of the process; null if there is no memory to keep it.
/// Safety: the vector that held the value is rebuilt empty from its own pointer and capacity, so its buffer is freed
/// and the value is never dropped or read again.
fn kept(memory: SharedMemory) -> usize? {
    let base = memory.address() as usize;
    // Never unmapped: the value goes into a vector that is taken apart, so it is not dropped, and the vector's
    // buffer is given back as that of an empty one.
    var kept = Vector<SharedMemory>.create();
    match (kept.push(memory)) {
        Ok() => {}
        Err(_) => { return null; }
    }
    let parts = Vector.intoRaw(kept);
    let empty = unsafe { Vector<SharedMemory>.fromRaw(parts.pointer, 0, parts.capacity) };
    return Some(base);
}

/// The address of `bytes` bytes of zeroed memory of this process's own, kept for the life of the process; null if
/// the system gives none.
fn sharedBytes(bytes: usize) -> usize? {
    match (SharedMemory.anonymous(bytes)) {
        Ok(m) => { return kept(m); }
        Err(_) => { return null; }
    }
}

/// So many 64-bit words, all zero at first, changed only atomically: shared by the supervisor's workers when made by
/// `Supervisor.words`, this process's own when made by `create`. It stays mapped for the life of the process.
public struct SharedWords {
    /// The mapping's address. A number, not a pointer: a struct that holds a raw pointer is not Send, and this one
    /// is for every thread and process to use.
    private base: usize;
    private count: usize;

    /// `count` words (rounded up to a power of two, at least 64) of this process's own, or null if the system
    /// gives no memory. For workers to share, `Supervisor.words`.
    public fn create(count: usize) -> SharedWords? {
        let size = SharedWords.sizeFor(count);
        let base = sharedBytes(size * 8) ?? { return null; };
        return Some(SharedWords { base: base, count: size });
    }

    /// How many words `count` is rounded up to.
    fn sizeFor(count: usize) -> usize {
        var size: usize = 64;
        while (size < count) {
            size *= 2;
        }
        return size;
    }

    /// The words at `base`, which is `size` words kept for the life of the process.
    fn at(base: usize, size: usize) -> SharedWords => SharedWords { base: base, count: size };

    /// How many words there are: a power of two.
    public fn length(this) -> usize => this.count;

    /// Word `index` (taken modulo the length).
    /// Safety: the mapping is `count` words long, page aligned, never unmapped, and an `AtomicU64` is one 64-bit
    /// word that is only ever accessed atomically; the index is brought into range.
    public fn word(borrow this, index: usize) -> borrow AtomicU64 =>
        unsafe { Ptr.toBorrow((this.base as *mut AtomicU64).add(index & (this.count - 1))) };
}
