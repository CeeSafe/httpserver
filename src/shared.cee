// Memory the supervisor's workers share: words, each changed atomically.
//
// It is mapped before the workers are forked, so every worker has it at the same place. Only words go in it: no
// locks, no pointers, nothing that is allocated. A worker that traps half way through a change has then changed one
// word or not, and cannot leave the others something half written to trust or a lock nobody will release.
import web_core;

/// So many 64-bit words shared by this process and the processes forked from it, all zero at first. Make it before
/// `supervise`; it stays mapped for the life of the process. POSIX only.
public struct SharedWords {
    /// The mapping's address. A number, not a pointer: a struct that holds a raw pointer is not Send, and this one
    /// is for every thread and process to use.
    private base: usize;
    private count: usize;

    /// `count` words (rounded up to a power of two, at least 64), or null if the system gives no shared memory.
    /// Safety: `mmap` is asked for a new anonymous mapping and its result is checked.
    public fn create(count: usize) -> SharedWords? {
        var size: usize = 64;
        while (size < count) {
            size *= 2;
        }
        let page = unsafe { mmap(0 as *mut void, size * 8, PROT_READ + PROT_WRITE, MAP_SHARED + MAP_ANON, -1, 0) };
        if (page == 0 as *mut void || page as usize == 0xFFFFFFFFFFFFFFFF) {
            return null;
        }
        return Some(SharedWords { base: page as usize, count: size });
    }

    /// How many words there are: a power of two.
    public fn length(this) -> usize => this.count;

    /// Word `index` (taken modulo the length).
    /// Safety: the mapping is `count` words long, page aligned, never unmapped, and an `AtomicU64` is one 64-bit
    /// word that is only ever accessed atomically; the index is brought into range.
    public fn word(borrow this, index: usize) -> borrow AtomicU64 =>
        unsafe { Ptr.toBorrow((this.base as *mut AtomicU64).add(index & (this.count - 1))) };
}
