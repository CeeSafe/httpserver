// Memory the supervisor's workers share: words, each changed atomically.
//
// It is mapped before the workers are forked, so every worker has it at the same place. The memory is ceesafec's
// `SharedMemory` (0.71.0), with its name taken away at once: the workers have it by being forked, nothing finds it
// by name, and a supervisor that is killed leaves nothing behind. Only words go in it: no
// locks, no pointers, nothing that is allocated. A worker that traps half way through a change has then changed one
// word or not, and cannot leave the others something half written to trust or a lock nobody will release.
import web_core;

/// Counts the mappings this process has made, for their names.
static MAPPINGS: AtomicU64 = AtomicU64.constant(0);

/// The address of `bytes` bytes of zeroed memory shared with the processes forked from this one, kept for the life
/// of the process; null if the system gives none.
/// Safety: the vector that held the mapping's value is rebuilt empty from its own pointer and capacity, so its
/// buffer is freed and the value is never dropped or read again.
fn sharedBytes(bytes: usize) -> usize? {
    // A name of this process's own: "hs-<process id>-<which>". One left by a process that was killed between the
    // two calls below, and had this id, is taken away and the name tried again.
    var text = [0u8; 30];
    var w = TextWriter.create(mut text[..]);
    w.text("hs-");
    w.decimal(Process.id());
    w.text("-");
    w.decimal(MAPPINGS.fetchAdd(1));
    let name = StringView.fromUtf8(w.written()) ?? { return null; };
    let memory = match (SharedMemory.create(name, bytes)) {
        Ok(m) => m,
        Err(IoError.AlreadyExists) => {
            let _ = SharedMemory.remove(name);
            match (SharedMemory.create(name, bytes)) {
                Ok(m) => m,
                Err(_) => { return null; },
            }
        },
        Err(_) => { return null; },
    };
    let _ = SharedMemory.remove(name);
    let base = memory.address() as usize;
    // Never unmapped: the value goes into a vector that is taken apart, so it is not dropped, and the vector's
    // buffer is given back as that of an empty one.
    var kept = Vector<SharedMemory>.create();
    match (kept.push(memory)) {
        Ok() => {}
        Err(_) => { return null; }
    }
    let parts = Vector.intoRaw(kept);
    let empty = unsafe { Vector<SharedMemory>.fromRaw(parts.pointer, 0, parts.capacity) };
    return Some(base);
}

/// So many 64-bit words shared by this process and the processes forked from it, all zero at first. Make it before
/// `supervise`; it stays mapped for the life of the process.
public struct SharedWords {
    /// The mapping's address. A number, not a pointer: a struct that holds a raw pointer is not Send, and this one
    /// is for every thread and process to use.
    private base: usize;
    private count: usize;

    /// `count` words (rounded up to a power of two, at least 64), or null if the system gives no shared memory.
    public fn create(count: usize) -> SharedWords? {
        var size: usize = 64;
        while (size < count) {
            size *= 2;
        }
        let base = sharedBytes(size * 8) ?? { return null; };
        return Some(SharedWords { base: base, count: size });
    }

    /// How many words there are: a power of two.
    public fn length(this) -> usize => this.count;

    /// Word `index` (taken modulo the length).
    /// Safety: the mapping is `count` words long, page aligned, never unmapped, and an `AtomicU64` is one 64-bit
    /// word that is only ever accessed atomically; the index is brought into range.
    public fn word(borrow this, index: usize) -> borrow AtomicU64 =>
        unsafe { Ptr.toBorrow((this.base as *mut AtomicU64).add(index & (this.count - 1))) };
}
