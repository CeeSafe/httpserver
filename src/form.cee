// Form bodies: `application/x-www-form-urlencoded` and `multipart/form-data` (RFC 7578). Both read a body the
// handler has already taken whole (`exchange.readToEnd`), which the application's `Limits.maxBodyBytes` bounds, and
// give views of it: nothing is copied but a decoded value the handler asks for.
import web_http;

/// A URL-encoded form body: `name=value` pairs separated by `&`.
public struct Form {
    /// The value of the first `name` in `body`, decoded into `out` (cleared first): escapes resolved and `+` as a
    /// space. False if there is no such name, its escapes are malformed, or `out` could not grow.
    public fn value(body: Slice<u8>, name: StringView, out: borrow mut Vector<u8>) -> bool {
        out.clear();
        let wanted = name.bytes();
        var at: usize = 0;
        while (at <= body.length) {
            var end = at;
            while (end < body.length && body[end] != 38) {
                end += 1;
            }
            var eq = at;
            while (eq < end && body[eq] != 61) {
                eq += 1;
            }
            if (sameBytes(body[at..eq], wanted)) {
                return percentDecode(if (eq < end) body[eq + 1..end] else body[end..end], true, out);
            }
            at = end + 1;
        }
        return false;
    }
}

/// One part of a multipart body.
public struct Part<region r> {
    /// The field's name (`Content-Disposition`'s `name`), as sent.
    public name: Slice<r, u8>;
    /// The file's name as the browser gave it, for a file field; never to be used as a path without a check.
    public filename: Slice<r, u8>?;
    /// The part's `Content-Type`, if it has one.
    public contentType: Slice<r, u8>?;
    /// The part's bytes.
    public data: Slice<r, u8>;
}

/// The parts of a `multipart/form-data` body, in order: `var parts = Multipart.of(body, boundary);`, then
/// `parts.next()` until it is null. `failed()` afterwards tells a body that ended properly from one that is not
/// multipart or was cut. (It is not Copy, so that a `for` loop cannot walk a copy and leave `failed()` unasked.)
@noncopy
public struct Multipart<region r> {
    private body: Slice<r, u8>;
    private mark: Slice<r, u8>;
    /// Where the next part's headers start; `body.length + 1` once done.
    private at: usize;
    private broken: bool;
    private left: u32;

    /// The boundary a request's `Content-Type` gives (`multipart/form-data; boundary=…`), or null if it is not
    /// multipart or has none. A boundary is 1 to 70 characters (RFC 2046 §5.1.1).
    public fn boundary(contentType: Slice<r, u8>) -> Slice<r, u8>? {
        let kind = "multipart/form-data".bytes();
        if (contentType.length < kind.length || !Ascii.equalsIgnoringCase(
            contentType[0..kind.length],
            "multipart/form-data",
        )) {
            return null;
        }
        var at = kind.length;
        while (at < contentType.length) {
            // one `; name=value`
            while (at < contentType.length &&
                (contentType[at] == 59 || contentType[at] == 32 || contentType[at] == 9)) {
                at += 1;
            }
            var eq = at;
            while (eq < contentType.length && contentType[eq] != 61 && contentType[eq] != 59) {
                eq += 1;
            }
            if (eq >= contentType.length || contentType[eq] == 59) {
                at = eq;
                continue;
            }
            var from = eq + 1;
            var to = from;
            if (from < contentType.length && contentType[from] == 34) {
                from += 1;
                to = from;
                while (to < contentType.length && contentType[to] != 34) {
                    to += 1;
                }
            } else {
                while (to < contentType.length && contentType[to] != 59 && contentType[to] != 32) {
                    to += 1;
                }
            }
            if (Ascii.equalsIgnoringCase(contentType[at..eq], "boundary")) {
                if (to == from || to - from > 70) {
                    return null;
                }
                return Some(contentType[from..to]);
            }
            at = if (to < contentType.length && contentType[to] == 34) to + 1 else to;
        }
        return null;
    }

    /// The parts of `body`, delimited by `boundary`; at most 1000 are given.
    public fn of(body: Slice<r, u8>, boundary: Slice<r, u8>) -> Multipart<r> {
        var m = Multipart { body: body, mark: boundary, at: 0, broken: false, left: 1000 };
        // Up to the first delimiter is a preamble to ignore; the delimiter starts the body or follows a line end.
        match (m.delimiter(0, true)) {
            Some(found) => { m.at = found; }
            null => {
                m.broken = true;
                m.at = body.length + 1;
            }
        }
        return m;
    }

    /// Whether the body was not well-formed multipart: no delimiter, a part without a name or without its end, or
    /// more parts than are given.
    public fn failed(borrow this) -> bool => this.broken;

    /// The index after the next `--boundary` at or after `from` that starts a line (or, with `first`, the body);
    /// null if there is none.
    fn delimiter(borrow this, from: usize, first: bool) -> usize? {
        let b = this.body;
        let n = this.mark.length;
        var i = from;
        while (i + 2 + n <= b.length) {
            let lineStart = (first && i == 0) || (i >= 2 && b[i - 2] == 13 && b[i - 1] == 10);
            if (lineStart && b[i] == 45 && b[i + 1] == 45 && sameBytes(b[i + 2..i + 2 + n], this.mark)) {
                // A delimiter's line holds nothing more than `--` or padding: `--boundaryX` in a part is data.
                var j = i + 2 + n;
                let closes = j + 2 <= b.length && b[j] == 45 && b[j + 1] == 45;
                while (j < b.length && (b[j] == 32 || b[j] == 9)) {
                    j += 1;
                }
                if (closes || (j + 2 <= b.length && b[j] == 13 && b[j + 1] == 10)) {
                    return Some(i + 2 + n);
                }
            }
            i += 1;
        }
        return null;
    }

    fn stop(borrow mut this, broken: bool) -> Part<r>? {
        this.broken = this.broken || broken;
        this.at = this.body.length + 1;
        return null;
    }

    /// The next part, or null after the last.
    public fn next(borrow mut this) -> Part<r>? {
        let b = this.body;
        if (this.at > b.length) {
            return null;
        }
        // After a delimiter: `--` ends the body; otherwise the rest of the line is padding.
        var at = this.at;
        if (at + 2 <= b.length && b[at] == 45 && b[at + 1] == 45) {
            return this.stop(false);
        }
        while (at < b.length && (b[at] == 32 || b[at] == 9)) {
            at += 1;
        }
        if (at + 2 > b.length || b[at] != 13 || b[at + 1] != 10) {
            return this.stop(true);
        }
        at += 2;
        if (this.left == 0) {
            return this.stop(true);
        }
        this.left -= 1;
        var part = Part { name: b[0..0], filename: null, contentType: null, data: b[0..0] };
        var named = false;
        // Header lines up to an empty one.
        loop {
            var end = at;
            while (end + 1 < b.length && !(b[end] == 13 && b[end + 1] == 10)) {
                end += 1;
            }
            if (end + 1 >= b.length) {
                return this.stop(true);
            }
            if (end == at) {
                at += 2;
                break;
            }
            let line = b[at..end];
            var colon: usize = 0;
            while (colon < line.length && line[colon] != 58) {
                colon += 1;
            }
            if (colon < line.length) {
                let value = trimWhitespace(line[colon + 1..]);
                if (Ascii.equalsIgnoringCase(line[0..colon], "content-disposition")) {
                    match (parameter(value, "name")) {
                        Some(v) => {
                            part.name = v;
                            named = true;
                        }
                        null => {}
                    }
                    part.filename = parameter(value, "filename");
                } else if (Ascii.equalsIgnoringCase(line[0..colon], "content-type")) {
                    part.contentType = Some(value);
                }
            }
            at = end + 2;
        }
        // The data runs to the line end before the next delimiter. With no data at all the delimiter follows the
        // empty line directly, and its line end is the one just passed.
        let next = this.delimiter(at, false) ?? { return this.stop(true); };
        let delimiterStart = next - 2 - this.mark.length;
        part.data = if (delimiterStart >= at + 2) b[at..delimiterStart - 2] else b[at..at];
        this.at = next;
        if (!named) {
            return this.stop(true);
        }
        return Some(part);
    }
}

/// The value of the parameter `name` in a `Content-Disposition` value (`form-data; name="a"; filename="b.txt"`):
/// what is between the quotes, or an unquoted token. A quoted value ends at the first `"` not after a backslash;
/// escapes are left as sent.
fn parameter<region r>(value: Slice<r, u8>, name: StringView) -> Slice<r, u8>? {
    var at: usize = 0;
    while (at < value.length) {
        // to the next `;`, outside quotes
        var end = at;
        var quoted = false;
        while (end < value.length && (quoted || value[end] != 59)) {
            if (value[end] == 92 && quoted && end + 1 < value.length) {
                end += 1;
            } else if (value[end] == 34) {
                quoted = !quoted;
            }
            end += 1;
        }
        let item = trimWhitespace(value[at..end]);
        var eq: usize = 0;
        while (eq < item.length && item[eq] != 61) {
            eq += 1;
        }
        if (eq < item.length && Ascii.equalsIgnoringCase(trimWhitespace(item[0..eq]), name)) {
            let v = trimWhitespace(item[eq + 1..]);
            if (v.length >= 2 && v[0] == 34 && v[v.length - 1] == 34) {
                return Some(v[1..v.length - 1]);
            }
            return Some(v);
        }
        at = end + 1;
    }
    return null;
}
