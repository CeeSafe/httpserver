// The application: its state, routes, groups and middleware, served over CeeSafe.Web's connection server and its
// HTTP/1.1 and HTTP/2 drivers. `App<S>` is a `web_http` `Application`, so the same value can be served over HTTP/3
// (`applicationOf` and `web_http3`'s `Http3Server.serve`).
import web_core;
import web_transport;
import web_http;
import web_http1;
import web_http2;

/// A group of routes: a path prefix and the middleware its routes run. Group 0 is the application itself.
struct Group {
    prefix: Vector<u8>;
    parent: u32;
    /// The middleware in the order it runs: indexes into the application's `hooks`.
    chain: Vector<u32>;
    /// The longest a request to one of its routes may take; 0: as its parent's.
    timeoutMs: u64;
    /// The most memory a request to one of its routes may hold at once; 0: as its parent's.
    budgetBytes: usize;
}

/// What an application tells of each request it has answered: `App.logTo`.
public interface AccessLog {
    /// One request. `scope` has its connection and what the filters left (`"trace"`, `"user"`). `status` is the
    /// response's, 0 if the connection failed before one was sent; `micros` is the
    /// time from the request's head to the handler's return, body included when the handler sent it whole.
    async fn record(borrow this, request: borrow Request, scope: borrow Scope, status: u16, micros: u64);
}

/// An HTTP application whose state is `S`.
public struct App<S: Send + Share> {
    private appState: S;
    private routes: Router<S>;
    private hooks: Vector<Box<dyn Middleware<S> + Send + Share>>;
    private groups: Vector<Group>;
    private httpLimits: Limits;
    /// The UDP port the same application is served on over HTTP/3, advertised in `Alt-Svc`.
    private http3Port: u16?;
    private log: Box<dyn AccessLog + Send + Share>?;
    /// How long one resume of a task may compute without waiting, in milliseconds (`bound`); 0: no bound; null: the
    /// default, which depends on whether the slice can pause a task (`applyLimits`).
    private boundMs: u64?;
    /// How long a task of an isolated connection computes before it is paused and the others run (`slice`); 0: none.
    private sliceMs: u64;

    /// An application owning `state`, with no routes and no middleware; `limits` bound each connection's requests.
    public fn create(state: S, limits: Limits) -> Result<App<S>, RouteError> {
        let routes = Router<S>.create()?;
        var groups = Vector<Group>.create();
        match (groups.push(
            Group { prefix: Vector<u8>.create(), parent: 0, chain: Vector<u32>.create(), timeoutMs: 0, budgetBytes: 0 },
        )) {
            Ok() => {}
            Err(_) => { return Err(RouteError.OutOfMemory); }
        }
        return Ok(App {
            appState: state,
            routes: routes,
            hooks: Vector<Box<dyn Middleware<S> + Send + Share>>.create(),
            groups: groups,
            httpLimits: limits,
            http3Port: null,
            log: null,
            boundMs: null,
            sliceMs: defaultSliceMs(),
        });
    }

    /// Adds `m` for every request, after the middleware already added: its `before` runs after theirs, its `after`
    /// before theirs.
    public fn use(borrow mut this, m: Box<dyn Middleware<S> + Send + Share>) -> Result<void, RouteError> =>
        this.useIn(0, m);

    /// Adds `m` for the routes of `group` and of the groups under it, after the middleware they already have.
    public fn useIn(borrow mut this, group: u32, m: Box<dyn Middleware<S> + Send + Share>) -> Result<void, RouteError> {
        if (group as usize >= this.groups.length) {
            return Err(RouteError.NoSuchGroup);
        }
        match (this.hooks.push(m)) {
            Ok() => {}
            Err(_) => { return Err(RouteError.OutOfMemory); }
        }
        return this.chained(group, truncate<u32>(this.hooks.length - 1));
    }

    /// Runs the application's middleware, then what `found` says: the route's group's middleware and its handler, or
    /// the answer for a path without one. The context is the caller's, which reads it afterwards for the access log.
    async fn dispatch(
        borrow this,
        found: RouteMatch,
        ctx: borrow mut Context<S>,
        request: borrow Request,
        exchange: borrow mut Exchange,
    ) -> Result<void, HandlerError> {
        match (await this.before(found, ctx, request, exchange)?) {
            Flow.Responded => { return Ok(); }
            Flow.Continue => {}
        }
        match (found) {
            RouteMatch.Found(index) => { return await this.routes.handler(index).handle(ctx, request, exchange); }
            _ => { return await this.unrouted(found, request, exchange); }
        }
    }

    /// Runs the application's middleware, then that of the group of the route `found` names; whether one of them
    /// answered.
    async fn before(
        borrow this,
        found: RouteMatch,
        ctx: borrow mut Context<S>,
        request: borrow Request,
        exchange: borrow mut Exchange,
    ) -> Result<Flow, HandlerError> {
        let everywhere = borrow this.groups[0].chain;
        for (i in 0..everywhere.length) {
            match (await this.enter(everywhere[i], mut ctx, request, exchange)?) {
                Flow.Continue => {}
                Flow.Responded => { return Ok(Flow.Responded); }
            }
        }
        match (found) {
            RouteMatch.Found(index) => {
                let group = this.routes.group(index);
                if (group != 0) {
                    // a group's chain starts with nothing of the application's: those ran above
                    let chain = borrow this.groups[group as usize].chain;
                    for (i in 0..chain.length) {
                        match (await this.enter(chain[i], mut ctx, request, exchange)?) {
                            Flow.Continue => {}
                            Flow.Responded => { return Ok(Flow.Responded); }
                        }
                    }
                }
            }
            _ => {}
        }
        return Ok(Flow.Continue);
    }

    /// The answer for a path without a route for the request's method.
    async fn unrouted(
        borrow this,
        found: RouteMatch,
        request: borrow Request,
        exchange: borrow mut Exchange,
    ) -> Result<void, HandlerError> {
        match (found) {
            RouteMatch.MethodNotAllowed(mask) => {
                let options = Methods.same(request.method(), Method.Options);
                var text = [0u8; 96];
                let n = allowText(mask | (1u32 << Methods.index(Method.Options)), mut text);
                exchange.header("allow", text[0..n])?;
                let status = if (options) Status.noContent() else Status.methodNotAllowed();
                return await exchange.send(status, "".bytes());
            }
            _ => {
                let options = Methods.same(request.method(), Method.Options);
                let asterisk = Ascii.equals(request.path().bytes(), "*");
                let status = if (options && asterisk) Status.noContent() else Status.notFound();
                return await exchange.send(status, "".bytes());
            }
        }
    }

    /// Bounds every request: one whose middleware and handler have not returned after `ms` is cancelled and
    /// answered 504, or its connection closed if the response had begun. 0, the default, is no bound. The time runs
    /// while the handler waits (for a body, a database, a client that reads slowly), not while it computes: a
    /// handler that never awaits is the supervisor's to stop.
    public fn timeout(borrow mut this, ms: u64) {
        this.groups[0].timeoutMs = ms;
    }

    /// `timeout` for the routes of `group` and of the groups under it that set none: a longer one for uploads, a
    /// shorter one for an API.
    public fn timeoutIn(borrow mut this, group: u32, ms: u64) -> Result<void, RouteError> {
        if (group as usize >= this.groups.length) {
            return Err(RouteError.NoSuchGroup);
        }
        this.groups[group as usize].timeoutMs = ms;
        return Ok();
    }

    /// The bound on a request to a route of `group`.
    fn timeoutOf(borrow this, group: u32) -> u64 {
        var at = group;
        loop {
            let ms = this.groups[at as usize].timeoutMs;
            if (ms != 0 || at == 0) {
                return ms;
            }
            at = this.groups[at as usize].parent;
        }
    }

    /// Bounds the memory every request may hold at once (ceesafec's `Budget`): an allocation of its middleware or
    /// handler, or of a task they start, that would take the request past `bytes` fails as an allocation fails
    /// when the system has no memory, and the code that asked answers for it (413, 503, a shorter result). 0, the
    /// default, is no bound. The request's own blocks are counted, as the C library sizes them; what C libraries
    /// take for themselves is not. A worker's address-space limit (`ServeOptions.memoryBytes`) stays the backstop.
    public fn budget(borrow mut this, bytes: usize) {
        this.groups[0].budgetBytes = bytes;
    }

    /// `budget` for the routes of `group` and of the groups under it that set none: more for uploads.
    public fn budgetIn(borrow mut this, group: u32, bytes: usize) -> Result<void, RouteError> {
        if (group as usize >= this.groups.length) {
            return Err(RouteError.NoSuchGroup);
        }
        this.groups[group as usize].budgetBytes = bytes;
        return Ok();
    }

    /// The bound on the memory of a request to a route of `group`.
    fn budgetOf(borrow this, group: u32) -> usize {
        var at = group;
        loop {
            let bytes = this.groups[at as usize].budgetBytes;
            if (bytes != 0 || at == 0) {
                return bytes;
            }
            at = this.groups[at as usize].parent;
        }
    }

    /// Tells `log` of every request once it is answered, one that found no route or timed out included.
    public fn logTo(borrow mut this, log: Box<dyn AccessLog + Send + Share>) {
        this.log = Some(log);
    }

    /// Adds chain entry `index` to `group` and the groups under it.
    fn chained(borrow mut this, group: u32, index: u32) -> Result<void, RouteError> {
        for (g in 0..this.groups.length) {
            // The application's own middleware is kept in group 0 alone: it runs before any group's.
            if ((group == 0 && g != 0) || !this.within(truncate<u32>(g), group)) {
                continue;
            }
            match (this.groups[g].chain.push(index)) {
                Ok() => {}
                Err(_) => { return Err(RouteError.OutOfMemory); }
            }
        }
        return Ok();
    }

    /// Whether group `g` is `ancestor` or under it.
    fn within(borrow this, g: u32, ancestor: u32) -> bool {
        var at = g;
        loop {
            if (at == ancestor) {
                return true;
            }
            if (at == 0) {
                return false;
            }
            at = this.groups[at as usize].parent;
        }
    }

    /// A group of routes under `prefix` (`/api`; empty for a group that only shares middleware).
    public fn group(borrow mut this, prefix: StringView) -> Result<u32, RouteError> => this.groupIn(0, prefix);

    /// A group under `parent`: its prefix follows the parent's, and it starts with the parent's middleware.
    public fn groupIn(borrow mut this, parent: u32, prefix: StringView) -> Result<u32, RouteError> {
        if (parent as usize >= this.groups.length) {
            return Err(RouteError.NoSuchGroup);
        }
        let p = prefix.bytes();
        if (p.length > 0 && (p[0] != 47 || p[p.length - 1] == 47)) {
            return Err(RouteError.BadPattern);
        }
        var g = Group {
            prefix: Vector<u8>.create(),
            parent: parent,
            chain: Vector<u32>.create(),
            timeoutMs: 0,
            budgetBytes: 0,
        };
        copyInto(mut g.prefix, this.groups[parent as usize].prefix.view())?;
        copyInto(mut g.prefix, p)?;
        if (parent != 0) {
            for (i in 0..this.groups[parent as usize].chain.length) {
                match (g.chain.push(this.groups[parent as usize].chain[i])) {
                    Ok() => {}
                    Err(_) => { return Err(RouteError.OutOfMemory); }
                }
            }
        }
        match (this.groups.push(g)) {
            Ok() => { return Ok(truncate<u32>(this.groups.length - 1)); }
            Err(_) => { return Err(RouteError.OutOfMemory); }
        }
    }

    /// Routes `method` requests for `pattern` to `handler` (the patterns: `Router`).
    public fn route(
        borrow mut this,
        method: Method,
        pattern: StringView,
        handler: Box<dyn Handler<S> + Send + Share>,
    ) -> Result<void, RouteError> =>
        this.routes.add(method, pattern.bytes(), 0, handler);

    /// Routes `method` requests for `group`'s prefix followed by `pattern` to `handler`, behind the group's
    /// middleware. `/` as the pattern is the prefix itself.
    public fn routeIn(
        borrow mut this,
        group: u32,
        method: Method,
        pattern: StringView,
        handler: Box<dyn Handler<S> + Send + Share>,
    ) -> Result<void, RouteError> {
        if (group as usize >= this.groups.length) {
            return Err(RouteError.NoSuchGroup);
        }
        let p = pattern.bytes();
        if (p.length == 0 || p[0] != 47) {
            return Err(RouteError.BadPattern);
        }
        var whole = Vector<u8>.create();
        copyInto(mut whole, this.groups[group as usize].prefix.view())?;
        if (p.length > 1 || whole.length == 0) {
            copyInto(mut whole, p)?;
        }
        return this.routes.add(method, whole.view(), group, handler);
    }

    /// `route` for GET.
    public fn get(
        borrow mut this,
        pattern: StringView,
        handler: Box<dyn Handler<S> + Send + Share>,
    ) -> Result<void, RouteError> =>
        this.routes.add(Method.Get, pattern.bytes(), 0, handler);

    /// `route` for POST.
    public fn post(
        borrow mut this,
        pattern: StringView,
        handler: Box<dyn Handler<S> + Send + Share>,
    ) -> Result<void, RouteError> =>
        this.routes.add(Method.Post, pattern.bytes(), 0, handler);

    /// `route` for PUT.
    public fn put(
        borrow mut this,
        pattern: StringView,
        handler: Box<dyn Handler<S> + Send + Share>,
    ) -> Result<void, RouteError> =>
        this.routes.add(Method.Put, pattern.bytes(), 0, handler);

    /// `route` for DELETE.
    public fn delete(
        borrow mut this,
        pattern: StringView,
        handler: Box<dyn Handler<S> + Send + Share>,
    ) -> Result<void, RouteError> =>
        this.routes.add(Method.Delete, pattern.bytes(), 0, handler);

    /// `route` for PATCH.
    public fn patch(
        borrow mut this,
        pattern: StringView,
        handler: Box<dyn Handler<S> + Send + Share>,
    ) -> Result<void, RouteError> =>
        this.routes.add(Method.Patch, pattern.bytes(), 0, handler);

    /// Runs chain entry `entry`'s `before`.
    async fn enter(
        borrow this,
        entry: u32,
        ctx: borrow mut Context<S>,
        request: borrow Request,
        exchange: borrow mut Exchange,
    ) -> Result<Flow, HandlerError> {
        return await this.hooks[entry as usize].before(ctx, request, exchange);
    }

    /// Advertises HTTP/3 on UDP `port` of the same host: every HTTP/1.1 and HTTP/2 response gains
    /// `alt-svc: h3=":<port>"; ma=86400` (RFC 7838 §3), unless the handler or a middleware set its own.
    public fn advertiseHttp3(borrow mut this, port: u16) {
        this.http3Port = Some(port);
    }

    /// The longest one resume of a task may compute without waiting, in milliseconds; 0 for none. `run` and
    /// `runShared` set it as the program's bound (`Async.runBound`, ceesafec ADR 0186) when they start. Under `run`, a
    /// request past it traps with `Overran` and costs its connection. By default it is 30 000 under `run` where the
    /// slice pauses a task (the request shares its worker meanwhile, so the bound is only for one that never ends),
    /// and 1 000 otherwise: under `runShared`, or where there is no slice, a task computing holds its worker's loop,
    /// and the bound must stay well below the supervisor's `stallMs` (5 000 by default). It needs a build with polls
    /// (`polls = true` in the program's manifest, ceesafec ADR 0190): without them `run` says so once and serves
    /// unbounded.
    public fn bound(borrow mut this, ms: u64) {
        this.boundMs = Some(ms);
    }

    /// The slice, in milliseconds (`Async.runSlice`, ceesafec ADR 0189): under `run`, a request that has computed for
    /// this long without waiting is paused, and its worker's other requests run before it goes on, so one that
    /// computes costs its neighbours about a slice at a time instead of the whole computation. 10 by default, 0 for
    /// none. `runShared` sets none: a task in no isolated unit is never paused. It needs a build with polls, and a
    /// 64-bit target; where the slice cannot be had, `run` says so once and keeps the shorter bound.
    public fn slice(borrow mut this, ms: u64) {
        this.sliceMs = ms;
    }

    /// The application's state.
    public fn state(borrow this) -> borrow S => borrow this.appState;

    /// The HTTP limits each connection's requests are held to.
    public fn limits(borrow this) -> borrow Limits => borrow this.httpLimits;

    /// Serves connections from `incoming` (a `Listener`, or a `MockIncoming` in tests) through `acceptor`, until
    /// `drain` finishes or `incoming` ends, each connection in an isolated task (CeeSafe.Web's
    /// `ConnectionServer.runIsolated`, Web ADR 0016; ceesafec ADR 0175), and each HTTP/2 or HTTP/3 stream too: a
    /// handler that traps ends its connection (or stream), whose socket is shut, and the server goes on. What the
    /// connection held is leaked; `Isolation.report()` counts it, and a supervised worker is replaced past the bound its
    /// options set (`SupervisorOptions.recycleCrashes`, `recycleLeakedBytes`). A trap in a C library's callback, or in
    /// a `Critical`, still ends the process. The application's `slice` and `bound` are the program's when it starts. A connection
    /// is HTTP/2 when TLS negotiated `h2`, or when it starts with HTTP/2's preface (prior knowledge, RFC 9113 §3.3);
    /// HTTP/1.1 otherwise.
    public async fn run(
        this,
        incoming: borrow dyn Incoming,
        acceptor: Box<dyn Acceptor + Send + Share>,
        limits: borrow ConnectionLimits,
        drain: borrow Drain,
    ) -> Result<ServerReport, NetError> {
        await applyLimits(this.sliceMs, this.boundMs);
        let httpLimits = this.httpLimits;
        let app = applicationOf(this)?;
        let boxed: Box<dyn ConnectionHandler + Send + Share> = match (Box.create(Serving {
            app: app,
            httpLimits: httpLimits,
        })) {
            Ok(b) => b,
            Err(_) => { return Err(NetError.OutOfMemory); },
        };
        let handler = match (Arc<Box<dyn ConnectionHandler + Send + Share>>.create(boxed)) {
            Ok(h) => h,
            Err(_) => { return Err(NetError.OutOfMemory); },
        };
        let accepting = match (Arc<Box<dyn Acceptor + Send + Share>>.create(acceptor)) {
            Ok(a) => a,
            Err(_) => { return Err(NetError.OutOfMemory); },
        };
        return await ConnectionServer.runIsolated(incoming, accepting, handler, limits, drain);
    }

    /// `run`'s name before httpserver 0.2.0, when `run` served connections in plain tasks. It goes in the release
    /// after 0.2.0.
    public async fn runIsolated(
        this,
        incoming: borrow dyn Incoming,
        acceptor: Box<dyn Acceptor + Send + Share>,
        limits: borrow ConnectionLimits,
        drain: borrow Drain,
    ) -> Result<ServerReport, NetError> => await this.run(incoming, acceptor, limits, drain);

    /// `run` with each connection in a plain task, as `run` did before httpserver 0.2.0: a trap in a handler ends the
    /// process, and every connection on it. For a trusted service measured to need what isolation costs. The
    /// application's `bound` is set as for `run`, and with no isolated unit to end, a task past it is counted
    /// (`Async.overruns()`), not ended.
    public async fn runShared(
        this,
        incoming: borrow dyn Incoming,
        acceptor: borrow dyn Acceptor,
        limits: borrow ConnectionLimits,
        drain: borrow Drain,
    ) -> Result<ServerReport, NetError> {
        await applyLimits(0, this.boundMs);
        let httpLimits = this.httpLimits;
        let app = applicationOf(this)?;
        let service = Serving { app: app, httpLimits: httpLimits };
        return await ConnectionServer.run(incoming, acceptor, service, limits, drain);
    }
}

/// The slice `App` sets when none is given (`App.slice`), in milliseconds: ADR 0189's measurement on the benchmark
/// server, where it cost `/small` about 2% and cut the wait beside a 300 ms request from 247 ms to 87 to 149 ms.
fn defaultSliceMs() -> u64 => 10;

/// The bound `App` sets when none is given and the slice pauses a task: a request that has computed for 30 s in one
/// resume, while sharing its worker, is taken to never end.
fn defaultSlicedBoundMs() -> u64 => 30000;

/// The bound `App` sets when none is given and no slice pauses a task: well below the supervisor's 5 000 ms stall.
fn defaultBoundMs() -> u64 => 1000;

/// Sets the program's slice (`Async.runSlice`, `sliceMs`, 0 for none) and then its bound on one resume of a task
/// (`Async.runBound`, `RunBound.Count`: a task in no isolated unit is counted, one in a unit ended; with a slice, the
/// bound counts the slices one resume used). `boundMs` null is the default, which depends on whether the slice took.
/// Says once what it could not set: polls missing from the build, or a slice on a target without one.
async fn applyLimits(sliceMs: u64, boundMs: u64?) {
    let sliced = sliceMs > 0 && Async.runSlice(sliceMs);
    let bound = boundMs ?? (if (sliced) defaultSlicedBoundMs() else defaultBoundMs());
    if (bound > 0 && !Async.runBound(bound, RunBound.Count)) {
        let _ = await AsyncConsole.writeLine(
            "httpserver: no polls in this build: a request that computes without waiting holds its worker (add polls = true to ceesafe.toml)",
        );
        return;
    }
    if (sliceMs > 0 && !sliced && bound > 0) {
        let _ = await AsyncConsole.writeLine(
            "httpserver: no slice on this target: a request that computes is ended at its bound, not paused",
        );
    }
}

/// `app` as a shared `web_http` application, which it owns from now on: what `run` serves over TCP, and what
/// `web_http3`'s `Http3Server.serve` takes to serve the same routes over HTTP/3.
public fn applicationOf<S: Send + Share>(app: App<S>) -> Result<Arc<Box<dyn Application + Send + Share>>, NetError> {
    let boxed: Box<dyn Application + Send + Share> = match (Box.create(app)) {
        Ok(b) => b,
        Err(_) => { return Err(NetError.OutOfMemory); },
    };
    match (Arc<Box<dyn Application + Send + Share>>.create(boxed)) {
        Ok(shared) => { return Ok(shared); }
        Err(_) => { return Err(NetError.OutOfMemory); }
    }
}

/// An application served over HTTP/1.1 and HTTP/2: the protocol is chosen per connection.
struct Serving {
    app: Arc<Box<dyn Application + Send + Share>>;
    httpLimits: Limits;
}

impl ConnectionHandler for Serving {
    async fn serve(
        borrow this,
        conn: borrow mut dyn Transport,
        ctx: borrow ConnectionContext,
    ) -> Result<void, NetError> {
        let h2 = match (conn.alpn()) {
            Alpn.Http2 => true,
            _ => false,
        };
        if (h2) {
            return await serveH2(conn, ctx, this.app, this.httpLimits, "".bytes());
        }
        // Cleartext, or TLS without `h2`: the first bytes tell HTTP/2's preface from an HTTP/1.1 request line. They
        // differ by the second byte at the latest, so this reads one segment as a rule.
        var first = [0u8; 24];
        var n: usize = 0;
        let text = clientPreface();
        let preface = text.bytes();
        let deadline = Deadline.after(this.httpLimits.headerTimeoutMs);
        while (n < first.length && prefixOf(first[0..n], preface)) {
            let got = match (await Transports.readWithin(conn, mut first[n..], deadline)) {
                Ok(v) => v,
                Err(NetError.TimedOut) => { return Ok(); },
                Err(e) => { return Err(e); },
            };
            if (got == 0) {
                return Ok(); // the client closed before a request
            }
            n += got;
        }
        if (n == first.length && prefixOf(first[..], preface)) {
            return await serveH2(conn, ctx, this.app, this.httpLimits, first[..]);
        }
        let app: borrow dyn Application = this.app.get();
        return await web_http1.serveFrom(conn, ctx, app, this.httpLimits, first[0..n]);
    }
}

/// Whether `bytes` is where `whole` starts.
fn prefixOf(bytes: Slice<u8>, whole: Slice<u8>) -> bool {
    if (bytes.length > whole.length) {
        return false;
    }
    for (i in 0..bytes.length) {
        if (bytes[i] != whole[i]) {
            return false;
        }
    }
    return true;
}

/// The status an access log is told: the response's, or what the driver will answer for `r` if the handler sent
/// none; 0 if the connection failed.
fn statusOf(exchange: borrow Exchange, r: borrow Result<void, HandlerError>) -> u16 {
    // A handler that returned has set the status, even where the head still waits in the buffer.
    if (exchange.headSent()) {
        return exchange.status().code();
    }
    return match (r) {
        Ok() => exchange.status().code(),
        Err(HandlerError.Status(code)) => code.code(),
        Err(HandlerError.Internal) => 500,
        Err(HandlerError.Io(_)) => 0,
    };
}

impl<S: Send + Share> Application for App<S> {
    /// Routes the request, runs the application's middleware in order, then the route's group's, then the handler. A
    /// path with no route is 404; a path with routes but none for the method is 405 with `Allow`, or 204 with `Allow`
    /// for OPTIONS (RFC 9110 §9.3.7, §15.5.6). `OPTIONS *` is 204.
    async fn handle(
        borrow this,
        request: borrow Request,
        exchange: borrow mut Exchange,
        connection: borrow ConnectionContext,
    ) -> Result<void, HandlerError> {
        var params = Params.empty();
        let found = this.routes.find(request.method(), request.path().bytes(), mut params);
        let group = match (found) {
            RouteMatch.Found(index) => this.routes.group(index),
            _ => 0,
        };
        let ms = this.timeoutOf(group);
        let began = if (this.log.isSome()) Clock.monotonicNanos() else 0;
        // The context is made here, and outlives the dispatch: the log reads what the filters left in it, also
        // for a request whose time was up.
        var ctx = Context<S>.create(this.appState, connection, this.routes, request.path(), params);
        var r: Result<void, HandlerError> = Ok();
        {
            // The request's budget is this task's while the guard lives, and the timeout's child task is made
            // under it. A request that cannot have its budget is not run without one.
            let bytes = this.budgetOf(group);
            var budget: Budget? = null;
            if (bytes != 0) {
                match (Budget.enter(bytes)) {
                    Ok(b) => { budget = Some(b); }
                    Err(_) => { return Err(HandlerError.Internal); }
                }
            }
            if (ms == 0) {
                r = await this.dispatch(found, mut ctx, request, exchange);
            } else {
                let late = StatusCode.of(504) ?? Status.notFound();
                r = await Async.timeout(
                    ms,
                    HandlerError.Status(late),
                    async () => await this.dispatch(found, mut ctx, request, exchange),
                );
            }
        }
        match (borrow this.log) {
            Some(log) => {
                let micros = (Clock.monotonicNanos() - began) / 1000;
                await log.record(request, ctx.scope(), statusOf(exchange, r), micros);
            }
            null => {}
        }
        return r;
    }

    /// The application's middleware's `after`, in reverse order.
    async fn beforeHead(
        borrow this,
        request: borrow Request,
        head: borrow mut ResponseHead,
    ) -> Result<void, HandlerError> {
        let everywhere = borrow this.groups[0].chain;
        var i = everywhere.length;
        while (i > 0) {
            i -= 1;
            let entry = everywhere[i];
            await this.hooks[entry as usize].after(request, head)?;
        }
        match (this.http3Port) {
            Some(port) => {
                let overTcp = match (request.version()) {
                    Version.Http3 => false,
                    _ => true,
                };
                if (overTcp && !head.has("alt-svc")) {
                    var text = [0u8; 32];
                    let n = altSvc(port, mut text);
                    match (head.add("alt-svc", text[0..n])) {
                        Ok() => {}
                        Err(_) => { return Err(HandlerError.Internal); }
                    }
                }
            }
            null => {}
        }
        return Ok();
    }
}

/// `h3=":<port>"; ma=86400` in `out`; its length.
fn altSvc(port: u16, out: borrow mut [u8; 32]) -> usize {
    let head = "h3=\":".bytes();
    let tail = "\"; ma=86400".bytes();
    var n: usize = 0;
    for (b in head) {
        out[n] = b;
        n += 1;
    }
    var digits = [0u8; 5];
    var k: usize = 5;
    var v = port;
    loop {
        k -= 1;
        digits[k] = 48 + truncate<u8>(v % 10);
        v /= 10;
        if (v == 0) {
            break;
        }
    }
    for (j in k..5) {
        out[n] = digits[j];
        n += 1;
    }
    for (b in tail) {
        out[n] = b;
        n += 1;
    }
    return n;
}

/// The methods in `mask` (over `Methods.index`), as an `Allow` value ("GET, HEAD, OPTIONS") in `out`; its length.
fn allowText(mask: u32, out: borrow mut [u8; 96]) -> usize {
    var n: usize = 0;
    for (i in 0..9u32) {
        if ((mask & (1u32 << i)) == 0) {
            continue;
        }
        let name = Methods.text(methodAt(i)).bytes();
        if (n > 0) {
            out[n] = 44;
            out[n + 1] = 32;
            n += 2;
        }
        for (b in name) {
            out[n] = b;
            n += 1;
        }
    }
    return n;
}

/// The method at `Methods.index` value `i` (0 to 8).
fn methodAt(i: u32) -> Method => match (i) {
    0 => Method.Get,
    1 => Method.Head,
    2 => Method.Post,
    3 => Method.Put,
    4 => Method.Delete,
    5 => Method.Connect,
    6 => Method.Options,
    7 => Method.Trace,
    _ => Method.Patch,
};
