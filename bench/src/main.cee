// The benchmark server: the routes of CeeSafe.Web's comparison contract (its benchmarks/servers/README.md), so that
// its conform.py checks this server and the same load compares it with the others, on 127.0.0.1:CW_PORT (8090 by
// default), HTTP/1.1 and h2c.
//
//   GET  /small          "hello, world\n"
//   GET  /4k, /64k       that many bytes of the alphabet
//   GET  /stream         1 MiB in 64 writes, with no declared length
//   GET  /json           {"message":"Hello, World!"}, serialised for each request
//   POST /echo           the request body back (at most 1 MiB)
//   GET  /users/{id:int} the id back: a route with a parameter, in a group (`/api/users/{id:int}` is behind CW_HOOKS
//                        more middleware)
//   POST /stop           starts the drain
//   GET  /worker         which worker process answered
//   GET  /crash          traps (an index out of bounds), which costs its connection, or with CW_ISOLATED=0 the process
//   GET  /crash/kept     traps holding the output cache's lock, which the next use of the cache repairs;
//                        only in a build with `--cflag -DHTTPSERVER_TRAP_HOOKS=1`, else a 404
//   GET  /crash/gz/{n:int} traps holding `/gz`'s encoder's lock, half way through n bytes, which the next `/gz` repairs
//                        (the same build)
//   GET  /spin           computes without end: past the bound it costs its connection; without polls it stops the loop
//   GET  /spin/{ms:int}  computes for ms milliseconds without waiting (at most a minute), then answers "spun"
//   GET  /kept/{n:int}   the same text through the output cache, kept for a minute
//   GET  /gz/{n:int}     n bytes of JSON-like text through `Compression`: gzip for a client that accepts it
//   GET  /z/{n:int}      the same text through `Codings`: zstd or Brotli, or gzip for a client that takes neither
//   GET  /chat           a WebSocket: every message a session sends goes to all the sessions of this process, and with
//                         CW_BUS=1 to those of every worker
//   GET  /bloat          allocates until an allocation fails, then answers how many MiB it got
//   GET  /job            how many times this worker's scheduled job has run (CW_JOBS=1)
//   GET  /job/trap/{n:int} the job's next run traps (n = 1), or every run does (n = 2); 0 for neither
//
// CW_PROCS=n runs n worker processes under the supervisor (src/supervisor.cee), which starts a worker again when it
// ends and kills one whose loop has stopped; CW_MEMORY_MB limits each worker's address space; CW_BUDGET_MB each request's memory. The
// workers accept from one socket the supervisor bound; CW_INHERIT=0 has each bind the shared port instead
// (SO_REUSEPORT), which on Linux spreads connections evenly, and for which a worker replaced while it drains needs
// `net.ipv4.tcp_migrate_req = 1` (5.14 and later) not to reset what waits in its socket's queue.
//
// Each connection is served in an isolated task (`App.run`): a trap costs its connection, not the worker, and a
// worker is replaced after CW_RECYCLE_CRASHES crashes (100 by default): another is started in its place at once, and
// it drains. CW_ISOLATED=0 serves them in plain tasks (`App.runShared`), where a trap ends the worker.
//
// CW_RUN_BOUND_MS=n is the application's bound on how long a task may compute without waiting (`App.bound`, 1 000 ms
// by default, 0 for none; `Async.runBound`, ceesafec ADR 0186), in a build with `--cflag -DCEE_POLLS=1`: a request
// that computes past it traps with `Overran` and costs its connection, where without it the event loop stops until
// the supervisor kills the worker. Under CW_ISOLATED=0 a task past it is counted, not ended (`RunBound.Count`). A
// build without the macro says so once a worker and runs unbounded.
//
// The worker's housekeeping runs under a `Services` supervisor (src/services.cee): the reading of the bus and, with
// CW_JOBS=1, a scheduler whose job runs every second. Each start of one is an isolated task, so a trap in it ends
// that start alone and it is started again; past CW_SERVICE_RESTARTS restarts in 30 s (5 by default) the supervisor
// gives up and the worker ends, for the process supervisor to start again.
//
// CW_BUS=1 gives the workers a bus: `/bus/say/{n}` says n to all of them, `/bus/heard` answers the worker and the
// last number it heard, `/forget/{n}` has every worker forget `/kept/{n}`, and `/bus/forget/{n}` only the others,
// through the bus.
//
// CW_LIMIT=n adds a rate limit of n requests an hour for each client address; with CW_SHARED=1 the supervisor's
// workers count in shared memory, so the limit is all of theirs together. CW_TRACE=1 adds the trace-context filter. CW_TIMEOUT_MS=n bounds every request (`App.timeout`); CW_LOG=1 adds an access log that only counts, CW_LOG=2 the
// stock one that writes a line a request to standard output.
//
// CW_HOOKS=n adds n middleware that do nothing to the application, to measure what one costs. CW_STOCK=1 adds the
// stock filters a public API would run: security headers, CORS for any origin, and a rate limit nobody reaches.
import web_core;
import web_transport;
import web_http;
import httpserver;
import httpserver_ws;
import httpserver_compress;
import web_ws;
import json.JsonWriter;

/// What a worker's application and its reading of the bus have in common.
struct Wiring {
    /// The counters the workers' rate limit shares (CW_SHARED=1).
    words: SharedWords?;
    /// This worker's publishing end of the bus (CW_BUS=1).
    sender: BusSender?;
    /// The last number another worker said on the bus, or this one did.
    heard: Arc<AtomicU64>;
    /// The cache of `/kept`.
    cache: Arc<OutputCache>;
    /// The sessions of `/chat`.
    hub: Arc<Hub>;
    /// The scheduled job's runs, and its traps to come (`/job/trap`).
    jobRuns: Arc<AtomicU64>;
    jobTraps: Arc<AtomicU64>;
}

/// The job of CW_JOBS=1: counts its runs, and traps when `/job/trap` asked it to.
struct Tick {
    runs: Arc<AtomicU64>;
    traps: Arc<AtomicU64>;
}

impl Job for Tick {
    async fn run(borrow this, at: i64) -> Result<void, JobError> {
        let asked = this.traps.get().load();
        if (asked == 1) {
            this.traps.get().store(0);
        }
        if (asked == 1 || asked == 2) {
            let few = [1u8, 2u8, 3u8];
            let i = truncate<usize>(asked) + 100;
            let _ = few[i]; // out of bounds: this start of the scheduler ends alone
        }
        let _ = this.runs.get().fetchAdd(1);
        return Ok();
    }
}

/// `/job` and `/job/trap/{n}`.
struct Jobs {
    trap: bool;
}

impl Handler<St> for Jobs {
    async fn handle(
        borrow this,
        ctx: borrow mut Context<St>,
        request: borrow Request,
        exchange: borrow mut Exchange,
    ) -> Result<void, HandlerError> {
        let wiring = borrow ctx.state().wiring;
        if (this.trap) {
            let n = ctx.paramInt("n") ?? 0;
            wiring.jobTraps.get().store(if (n == 1 || n == 2) truncate<u64>(n) else 0);
            return await exchange.send(Status.ok(), "ok".bytes());
        }
        var buffer = [0u8; 24];
        var w = TextWriter.create(mut buffer[..]);
        w.decimal(wiring.jobRuns.get().load());
        return await exchange.send(Status.ok(), w.written());
    }
}

/// What a worker does with the other workers' messages: topic 1 is a number said, topic 2 a target to forget,
/// topic 3 a message for the sessions of `/chat`.
struct Ears {
    heard: Arc<AtomicU64>;
    cache: Arc<OutputCache>;
    hub: Arc<Hub>;
}

impl BusSink for Ears {
    fn deliver(borrow this, from: u32, topic: u32, payload: Slice<u8>) {
        if (topic == 1) {
            var n: u64 = 0;
            for (b in payload) {
                n = n * 10 + (b - 48) as u64;
            }
            this.heard.get().store(n);
        } else if (topic == 2) {
            match (StringView.fromUtf8(payload)) {
                Some(target) => { this.cache.get().forget(target); }
                null => {}
            }
        } else if (topic == 3) {
            let _ = this.hub.get().deliverEncoded(payload);
        }
    }
}

/// `/bus/say/{n}` says n to every worker, `/bus/heard` answers `<worker> <last number heard>`, `/forget/{n}` has
/// every worker forget `/kept/{n}`, and `/bus/forget/{n}` every worker but the one that answers.
struct OnBus {
    what: u32;
}

impl Handler<St> for OnBus {
    async fn handle(
        borrow this,
        ctx: borrow mut Context<St>,
        request: borrow Request,
        exchange: borrow mut Exchange,
    ) -> Result<void, HandlerError> {
        let wiring = borrow ctx.state().wiring;
        var text = [0u8; 40];
        var w = TextWriter.create(mut text[..]);
        if (this.what == 0) {
            w.decimal(ctx.state().worker as u64);
            w.text(" ");
            w.decimal(wiring.heard.get().load());
            return await exchange.send(Status.ok(), w.written());
        }
        let n = ctx.paramInt("n") ?? 0;
        if (n < 0) {
            return Err(HandlerError.Status(Status.badRequest()));
        }
        var published = true;
        if (this.what == 1) {
            w.decimal(truncate<u64>(n));
            wiring.heard.get().store(truncate<u64>(n));
            match (wiring.sender) {
                Some(s) => { published = s.publish(1, w.written()); }
                null => {}
            }
        } else {
            w.text("/kept/");
            w.decimal(truncate<u64>(n));
            if (this.what == 2) {
                match (StringView.fromUtf8(w.written())) {
                    Some(target) => { wiring.cache.get().forget(target); }
                    null => {}
                }
            }
            match (wiring.sender) {
                Some(s) => { published = s.publish(2, w.written()); }
                null => {}
            }
        }
        return await exchange.send(Status.ok(), if (published) "ok".bytes() else "not published".bytes());
    }
}

struct St {
    /// Which worker process this is.
    worker: u32;
    sockets: WebSocketOptions;
    wiring: Wiring;
}

struct Fixed {
    body: Vector<u8>;
}

impl Handler<St> for Fixed {
    async fn handle(
        borrow this,
        ctx: borrow mut Context<St>,
        request: borrow Request,
        exchange: borrow mut Exchange,
    ) -> Result<void, HandlerError> =>
        await exchange.send(Status.ok(), this.body.view());
}

struct Stream {
    piece: Vector<u8>;
}

impl Handler<St> for Stream {
    async fn handle(
        borrow this,
        ctx: borrow mut Context<St>,
        request: borrow Request,
        exchange: borrow mut Exchange,
    ) -> Result<void, HandlerError> {
        exchange.setStatus(Status.ok());
        for (i in 0..64) {
            await exchange.write(this.piece.view())?;
        }
        return Ok();
    }
}

struct JsonRoute {}

impl Handler<St> for JsonRoute {
    async fn handle(
        borrow this,
        ctx: borrow mut Context<St>,
        request: borrow Request,
        exchange: borrow mut Exchange,
    ) -> Result<void, HandlerError> {
        var w = JsonWriter.compact();
        let written = w.beginObject().isOk() && w.key("message").isOk() && w.string("Hello, World!").isOk() &&
            w.endObject().isOk();
        if (!written) {
            return Err(HandlerError.Internal);
        }
        let body = match (w.finish()) {
            Ok(b) => b,
            Err(_) => { return Err(HandlerError.Internal); },
        };
        return await Reply.json(exchange, Status.ok(), body.view());
    }
}

struct Echo {}

impl Handler<St> for Echo {
    async fn handle(
        borrow this,
        ctx: borrow mut Context<St>,
        request: borrow Request,
        exchange: borrow mut Exchange,
    ) -> Result<void, HandlerError> {
        let size = match (exchange.remaining()) {
            Some(n) => if (n > 0 && n <= 1048576) n as usize else 1048576,
            null => 1048576,
        };
        var body = match (OwnedBuffer.create(size)) {
            Ok(b) => b,
            Err(_) => { return Err(HandlerError.Internal); },
        };
        await exchange.readToEnd(mut body)?;
        return await exchange.send(Status.ok(), body.readable());
    }
}

/// Answers the route's `id`.
struct User {}

impl Handler<St> for User {
    async fn handle(
        borrow this,
        ctx: borrow mut Context<St>,
        request: borrow Request,
        exchange: borrow mut Exchange,
    ) -> Result<void, HandlerError> {
        let id = ctx.param("id") ?? { return Err(HandlerError.Internal); };
        return await exchange.send(Status.ok(), id.bytes());
    }
}

struct Stop {}

impl Handler<St> for Stop {
    async fn handle(
        borrow this,
        ctx: borrow mut Context<St>,
        request: borrow Request,
        exchange: borrow mut Exchange,
    ) -> Result<void, HandlerError> {
        ctx.connection().drain().start();
        return await exchange.send(Status.ok(), "stopping".bytes());
    }
}

/// Answers the worker's index.
struct Which {}

impl Handler<St> for Which {
    async fn handle(
        borrow this,
        ctx: borrow mut Context<St>,
        request: borrow Request,
        exchange: borrow mut Exchange,
    ) -> Result<void, HandlerError> {
        var digit = [0u8; 1];
        digit[0] = truncate<u8>(48 + ctx.state().worker % 10);
        return await exchange.send(Status.ok(), digit[..]);
    }
}

/// Reads past the end of an array: a trap.
struct Crash {}

impl Handler<St> for Crash {
    async fn handle(
        borrow this,
        ctx: borrow mut Context<St>,
        request: borrow Request,
        exchange: borrow mut Exchange,
    ) -> Result<void, HandlerError> {
        let few = [1u8, 2u8, 3u8];
        let at = request.path().length + 100;
        var one = [0u8; 1];
        one[0] = few[at];
        return await exchange.send(Status.ok(), one[..]);
    }
}

/// Never awaits and never ends.
struct Spin {}

impl Handler<St> for Spin {
    async fn handle(
        borrow this,
        ctx: borrow mut Context<St>,
        request: borrow Request,
        exchange: borrow mut Exchange,
    ) -> Result<void, HandlerError> {
        var n: u64 = request.path().length as u64;
        while (n != 0) {
            n = n.wrappingMul(6364136223846793005).wrappingAdd(1442695040888963407) | 1;
        }
        return await exchange.send(Status.ok(), "".bytes());
    }
}

/// Computes for `ms` milliseconds without awaiting (at most a minute), then answers "spun": shorter than
/// CW_RUN_BOUND_MS it is answered, longer it is ended.
struct SpinFor {}

impl Handler<St> for SpinFor {
    async fn handle(
        borrow this,
        ctx: borrow mut Context<St>,
        request: borrow Request,
        exchange: borrow mut Exchange,
    ) -> Result<void, HandlerError> {
        let wanted = ctx.paramInt("ms") ?? 0;
        let ms: u64 = if (wanted < 0) 0 else if (wanted > 60000) 60000 else truncate<u64>(wanted);
        let until = Clock.monotonicNanos() + ms * 1000000;
        while (Clock.monotonicNanos() < until) {}
        return await exchange.send(Status.ok(), "spun".bytes());
    }
}

/// Takes memory a MiB at a time until an allocation fails (at most 64 GiB), frees it, and answers how many it got.
struct Bloat {}

impl Handler<St> for Bloat {
    async fn handle(
        borrow this,
        ctx: borrow mut Context<St>,
        request: borrow Request,
        exchange: borrow mut Exchange,
    ) -> Result<void, HandlerError> {
        var blocks = Vector<OwnedBuffer>.create();
        var got: u64 = 0;
        while (got < 65536) {
            var block = match (OwnedBuffer.create(1048576)) {
                Ok(b) => b,
                Err(_) => { break; },
            };
            // touched, so that the memory is the process's and not only promised
            var page: usize = 0;
            let room = block.spare();
            while (page < room.length) {
                room[page] = 1;
                page += 4096;
            }
            match (blocks.push(block)) {
                Ok() => {}
                Err(_) => { break; }
            }
            got += 1;
        }
        var text = [0u8; 24];
        var w = TextWriter.create(mut text[..]);
        w.decimal(got);
        return await exchange.send(Status.ok(), w.written());
    }
}

/// `n` bytes of text that reads like JSON: a few words in an order a generator gives, the same for the same `n`.
struct Packed {
    compression: Arc<Compression>;
}

fn word(k: u32) -> StringView => match (k) {
    0 => "\"status\":",
    1 => "\"ok\",",
    2 => "\"id\":",
    3 => "\"name\":",
    4 => "\"value\":",
    5 => "true,",
    6 => "false,",
    _ => "null,",
};

/// `n` bytes of the JSON-like text.
fn jsonLike(n: usize) -> Result<Vector<u8>, HandlerError> {
    var body = Vector<u8>.create();
    var x: u32 = 12345;
    while (body.length < n) {
        x = x.wrappingMul(1103515245).wrappingAdd(12345);
        for (b in word((x >> 16) % 8).bytes()) {
            if (body.length < n) {
                match (body.push(b)) {
                    Ok() => {}
                    Err(_) => { return Err(HandlerError.Internal); }
                }
            }
        }
    }
    return Ok(body);
}

/// The route's `n`, up to 16 MiB.
fn asked(ctx: borrow Context<St>) -> usize {
    let wanted = ctx.paramInt("n") ?? 0;
    return if (wanted < 0 || wanted > 16777216) 0usize else truncate<usize>(wanted);
}

impl Handler<St> for Packed {
    async fn handle(
        borrow this,
        ctx: borrow mut Context<St>,
        request: borrow Request,
        exchange: borrow mut Exchange,
    ) -> Result<void, HandlerError> {
        let body = jsonLike(asked(ctx))?;
        return await this.compression.get().send(request, exchange, Status.ok(), "application/json", body.view());
    }
}

/// Traps holding a lock: the output cache's (`/crash/kept`) or the encoder's of `/gz` (`/crash/gz/{n}`). Under
/// CW_ISOLATED=1 it costs the connection, and the lock is left poisoned for the next request to repair.
struct TrapHolding {
    cache: Arc<OutputCache>;
    compression: Arc<Compression>;
    inEncoder: bool;
}

impl Handler<St> for TrapHolding {
    async fn handle(
        borrow this,
        ctx: borrow mut Context<St>,
        request: borrow Request,
        exchange: borrow mut Exchange,
    ) -> Result<void, HandlerError> {
        if (this.inEncoder) {
            let body = jsonLike(asked(ctx))?;
            this.compression.get().trapHoldingLock(body.view());
        } else {
            this.cache.get().trapHoldingLock();
        }
        // Only a build without the hooks gets here.
        return await exchange.send(Status.notFound(), "no trap hooks in this build".bytes());
    }
}

/// The same text through an `OutputCache`, kept for a minute.
struct Stored {
    cache: Arc<OutputCache>;
}

impl Handler<St> for Stored {
    async fn handle(
        borrow this,
        ctx: borrow mut Context<St>,
        request: borrow Request,
        exchange: borrow mut Exchange,
    ) -> Result<void, HandlerError> {
        let body = jsonLike(asked(ctx))?;
        return await this.cache.get().send(request, exchange, Status.ok(), "application/json", body.view(), 60);
    }
}

/// The same text through `Codings`.
struct Coded {
    codings: Codings;
}

impl Handler<St> for Coded {
    async fn handle(
        borrow this,
        ctx: borrow mut Context<St>,
        request: borrow Request,
        exchange: borrow mut Exchange,
    ) -> Result<void, HandlerError> {
        let body = jsonLike(asked(ctx))?;
        return await this.codings.send(request, exchange, Status.ok(), "application/json", body.view());
    }
}

/// A chat room: each message goes to every session, the sender's included.
struct Chat {}

impl Handler<St> for Chat {
    async fn handle(
        borrow this,
        ctx: borrow mut Context<St>,
        request: borrow Request,
        exchange: borrow mut Exchange,
    ) -> Result<void, HandlerError> {
        let state = ctx.state();
        var ws = match (await accept(exchange, request, state.sockets, false)?) {
            Some(w) => w,
            null => { return Ok(); }, // refused: the response is sent
        };
        let hub = state.wiring.hub.get();
        let member = hub.join(ws.sender()) ?? { return Err(HandlerError.Internal); };
        var message = Vector<u8>.create();
        loop {
            match (await ws.receive(mut message)?) {
                Received.Message(kind) => {
                    let binary = match (kind) {
                        MessageKind.Binary => true,
                        MessageKind.Text => false,
                    };
                    let _ = hub.broadcast(binary, message.view());
                    // And to the sessions of the other workers, if there is a bus.
                    match (state.wiring.sender) {
                        Some(s) => {
                            var encoded = Vector<u8>.create();
                            if (Hub.encode("", binary, message.view(), mut encoded)) {
                                let _ = s.publish(3, encoded.view());
                            }
                        }
                        null => {}
                    }
                }
                Received.Closed(_) => { return Ok(); }
            }
        }
    }
}

/// A middleware that does nothing.
struct Idle {}

impl Middleware<St> for Idle {
    async fn before(
        borrow this,
        ctx: borrow mut Context<St>,
        request: borrow Request,
        exchange: borrow mut Exchange,
    ) -> Result<Flow, HandlerError> =>
        Ok(Flow.Continue);

    async fn after(borrow this, request: borrow Request, head: borrow mut ResponseHead) -> Result<void, HandlerError> =>
        Ok();
}

fn handler<H: Handler<St> + Send + Share>(
    b: Result<Box<H>, AllocError>,
) -> Result<Box<dyn Handler<St> + Send + Share>, RouteError> {
    match (b) {
        Ok(h) => {
            let d: Box<dyn Handler<St> + Send + Share> = h;
            return Ok(d);
        }
        Err(_) => { return Err(RouteError.OutOfMemory); }
    }
}

fn idle() -> Result<Box<dyn Middleware<St> + Send + Share>, RouteError> {
    match (Box.create(Idle {})) {
        Ok(m) => {
            let d: Box<dyn Middleware<St> + Send + Share> = m;
            return Ok(d);
        }
        Err(_) => { return Err(RouteError.OutOfMemory); }
    }
}

/// A boxed filter, or `OutOfMemory`.
fn stock<F: Middleware<St> + Send + Share>(
    f: Result<F, AllocError>,
) -> Result<Box<dyn Middleware<St> + Send + Share>, RouteError> {
    let filter = match (f) {
        Ok(v) => v,
        Err(_) => { return Err(RouteError.OutOfMemory); },
    };
    match (Box.create(filter)) {
        Ok(b) => {
            let d: Box<dyn Middleware<St> + Send + Share> = b;
            return Ok(d);
        }
        Err(_) => { return Err(RouteError.OutOfMemory); }
    }
}

fn corsForAll() -> Result<Cors, AllocError> => Ok(Cors.create(CorsOptions.any()?));

/// `count` bytes of the alphabet.
fn filled(count: usize) -> Result<Vector<u8>, RouteError> {
    var v = Vector<u8>.create();
    for (i in 0..count) {
        match (v.push(97 + truncate<u8>(i % 26))) {
            Ok() => {}
            Err(_) => { return Err(RouteError.OutOfMemory); }
        }
    }
    return Ok(v);
}

/// An access log that only counts: what the hook itself costs.
struct Counted {
    requests: AtomicU64;
}

impl AccessLog for Counted {
    async fn record(
        borrow this,
        request: borrow Request,
        scope: borrow Scope,
        status: u16,
        micros: u64,
    ) {
        this.requests.store(this.requests.load() + 1);
    }
}

fn setting(name: StringView, otherwise: u64) -> u64 {
    let text = match (Environment.variable(name)) {
        Some(t) => t,
        null => { return otherwise; },
    };
    return match (Ascii.parseDecimal(text.bytes())) {
        Some(v) => v,
        null => otherwise,
    };
}

fn application(worker: u32, wiring: Wiring) -> Result<App<St>, RouteError> {
    let words = wiring.words;
    let cache = wiring.cache.clone();
    var limits = Limits.defaults();
    limits.maxBodyBytes = 1048576;
    var app = App<St>.create(
        St { worker: worker, sockets: WebSocketOptions.defaults(), wiring: wiring },
        limits,
    )?;
    for (i in 0..setting("CW_HOOKS", 0)) {
        app.use(idle()?)?;
    }
    if (setting("CW_STOCK", 0) == 1) {
        app.use(stock(SecurityHeaders.defaults())?)?;
        app.use(stock(corsForAll())?)?;
        app.use(stock(RateLimit.create(0xFFFFFFFF, 60000, 4096))?)?;
    }
    let limit = setting("CW_LIMIT", 0);
    if (limit > 0) {
        // An hour's window: a check that counts requests does not meet its end.
        match (words) {
            Some(w) => { app.use(stock(RateLimit.shared(truncate<u32>(limit), 3600000, w))?)?; }
            null => { app.use(stock(RateLimit.create(truncate<u32>(limit), 3600000, 4096))?)?; }
        }
    }
    if (setting("CW_TRACE", 0) == 1) {
        let made: Result<Trace, AllocError> = Ok(Trace.create(true));
        app.use(stock(made)?)?;
    }
    app.timeout(setting("CW_TIMEOUT_MS", 0));
    app.budget(truncate<usize>(setting("CW_BUDGET_MB", 0) * 1048576));
    match (setting("CW_LOG", 0)) {
        1 => {
            let log: Box<dyn AccessLog + Send + Share> = match (Box.create(Counted { requests: AtomicU64.create(0) })) {
                Ok(b) => b,
                Err(_) => { return Err(RouteError.OutOfMemory); },
            };
            app.logTo(log);
        }
        2 => {
            let log: Box<dyn AccessLog + Send + Share> = match (Box.create(ConsoleLog {})) {
                Ok(b) => b,
                Err(_) => { return Err(RouteError.OutOfMemory); },
            };
            app.logTo(log);
        }
        _ => {}
    }
    var small = Vector<u8>.create();
    for (b in "hello, world\n".bytes()) {
        match (small.push(b)) {
            Ok() => {}
            Err(_) => { return Err(RouteError.OutOfMemory); }
        }
    }
    app.get("/small", handler(Box.create(Fixed { body: small }))?)?;
    app.get("/4k", handler(Box.create(Fixed { body: filled(4096)? }))?)?;
    app.get("/64k", handler(Box.create(Fixed { body: filled(65536)? }))?)?;
    app.get("/stream", handler(Box.create(Stream { piece: filled(16384)? }))?)?;
    app.get("/json", handler(Box.create(JsonRoute {}))?)?;
    app.post("/echo", handler(Box.create(Echo {}))?)?;
    app.post("/stop", handler(Box.create(Stop {}))?)?;
    app.get("/worker", handler(Box.create(Which {}))?)?;
    app.get("/crash", handler(Box.create(Crash {}))?)?;
    app.get("/spin", handler(Box.create(Spin {}))?)?;
    app.get("/spin/{ms:int}", handler(Box.create(SpinFor {}))?)?;
    app.get("/bloat", handler(Box.create(Bloat {}))?)?;
    app.get("/job", handler(Box.create(Jobs { trap: false }))?)?;
    app.get("/job/trap/{n:int}", handler(Box.create(Jobs { trap: true }))?)?;
    app.get("/chat", handler(Box.create(Chat {}))?)?;
    var coding = CodingOptions.defaults();
    coding.gzip = true;
    let codings = match (Codings.create(coding)) {
        Ok(c) => c,
        Err(_) => { return Err(RouteError.OutOfMemory); },
    };
    app.get("/z/{n:int}", handler(Box.create(Coded { codings: codings }))?)?;
    let compression = match (Compression.create(1024)) {
        Ok(c) => match (Arc<Compression>.create(c)) {
            Ok(a) => a,
            Err(_) => { return Err(RouteError.OutOfMemory); },
        },
        Err(_) => { return Err(RouteError.OutOfMemory); },
    };
    app.get("/gz/{n:int}", handler(Box.create(Packed { compression: compression.clone() }))?)?;
    app.get(
        "/crash/kept",
        handler(Box.create(TrapHolding { cache: cache.clone(), compression: compression.clone(), inEncoder: false }))?,
    )?;
    app.get(
        "/crash/gz/{n:int}",
        handler(Box.create(TrapHolding { cache: cache.clone(), compression: compression, inEncoder: true }))?,
    )?;
    app.get("/bus/heard", handler(Box.create(OnBus { what: 0 }))?)?;
    app.get("/bus/say/{n:int}", handler(Box.create(OnBus { what: 1 }))?)?;
    app.get("/forget/{n:int}", handler(Box.create(OnBus { what: 2 }))?)?;
    app.get("/bus/forget/{n:int}", handler(Box.create(OnBus { what: 3 }))?)?;
    let kept = app.group("/kept")?;
    let answering: Result<Cached, AllocError> = Ok(Cached.create(cache.clone()));
    app.useIn(kept, stock(answering)?)?;
    app.routeIn(kept, Method.Get, "/{n:int}", handler(Box.create(Stored { cache: cache }))?)?;
    app.get("/users/{id:int}", handler(Box.create(User {}))?)?;
    let api = app.group("/api")?;
    for (i in 0..setting("CW_HOOKS", 0)) {
        app.useIn(api, idle()?)?;
    }
    app.routeIn(api, Method.Get, "/users/{id:int}", handler(Box.create(User {}))?)?;
    return Ok(app);
}

async fn say(text: StringView) -> Result<void, NetError> {
    match (await AsyncConsole.writeLine(text)) {
        Ok() => { return Ok(); }
        Err(e) => { return Err(NetErrors.fromAsync(e)); }
    }
}

/// The listener for `CW_PORT`; `shared`: other processes may bind the same port (SO_REUSEPORT).
fn listening(shared: bool) -> Result<Listener, NetError> =>
    Listener.bindWith(address(), ListenOptions { backlog: 0, reuseAddress: true, reusePort: shared, v6Only: false });

/// `CW_PORT` on the loopback address.
fn address() -> SocketAddress {
    let p = setting("CW_PORT", 8090);
    let port = if (p > 0 && p < 65536) truncate<u16>(p) else 8090;
    return SocketAddresses.v4Loopback(port);
}

/// A worker's housekeeping: `tend`, and the services beside it. `tend` stays outside the services: it is what beats
/// and drains, and a crash in it should end the worker.
async fn housekeeping(
    worker: Worker,
    drain: borrow Drain,
    services: borrow Services,
) -> Result<ServerReport, NetError> {
    if (services.count() == 0) {
        return await tend<ServerReport>(worker, drain, 100);
    }
    let r: Result<Raced<ServerReport>, NetError> = await Async.race(
        async move () => await tend<ServerReport>(worker, drain, 100),
        async move () => {
            let ended = await services.run<ServerReport>(drain);
            match (ended) {
                Err(NetError.LimitExceeded) => {
                    let _ = await AsyncConsole.writeLine(
                        "worker: a service restarted too often: ending, to be replaced",
                    );
                }
                _ => {}
            }
            return ended;
        },
    );
    return match (r) {
        Ok(raced) => Ok(raced.value),
        Err(e) => Err(e),
    };
}

/// The worker's services: the reading of the bus, and with CW_JOBS=1 the scheduler.
fn services(worker: Worker, bus: Bus?, ears: Ears, wiring: borrow Wiring) -> Result<Services, AllocError> {
    let restarts = setting("CW_SERVICE_RESTARTS", 5);
    var services = Services.create(
        Strategy.OneForOne,
        Intensity { restarts: truncate<u32>(restarts), withinMs: 30000 },
    );
    match (bus) {
        Some(b) => {
            let carrier: Box<dyn Service + Send + Share> =
                Box.create(BusCarrier<Ears> { bus: b, worker: worker.ring(), sink: ears, everyMs: 5 })?;
            let _ = services.add("bus", carrier, Restart.Permanent)?;
        }
        null => {}
    }
    if (setting("CW_JOBS", 0) == 1) {
        var scheduler = Scheduler.create(Zone.Utc);
        let tick: Box<dyn Job + Send + Share> =
            Box.create(Tick { runs: wiring.jobRuns.clone(), traps: wiring.jobTraps.clone() })?;
        match (scheduler.every(1, tick)) {
            Ok(_) => {}
            Err(_) => { return Err(AllocError.OutOfMemory); }
        }
        let _ = services.add("scheduler", scheduler.service()?, Restart.Permanent)?;
    }
    return Ok(services);
}

async fn serve(
    app: App<St>,
    worker: Worker,
    listener: borrow dyn web_transport.Incoming,
    services: Services,
) -> Result<ServerReport, NetError> {
    let drain = Drain.create()?;
    var limits = ConnectionLimits.defaults();
    limits.graceMs = 1000;
    limits.workers = truncate<u32>(setting("CW_WORKERS", 256));
    if (!worker.supervised()) {
        await say("bench: listening")?;
    }
    // The server owns the application, so its child moves it; the rest is lent to both.
    let bounds = borrow limits;
    let draining = borrow drain;
    let tending = borrow services;
    let isolated = setting("CW_ISOLATED", 1) == 1;
    let r: Result<Raced<ServerReport>, NetError> = await Async.race(
        async move () => {
            if (isolated) {
                let acceptor: Box<dyn Acceptor + Send + Share> = match (Box.create(PlainAcceptor {})) {
                    Ok(b) => b,
                    Err(_) => { return Err(NetError.OutOfMemory); },
                };
                return await app.run(listener, acceptor, bounds, draining);
            }
            return await app.runShared(listener, PlainAcceptor {}, bounds, draining);
        },
        async move () => await housekeeping(worker, draining, tending),
    );
    return match (r) {
        Ok(raced) => Ok(raced.value),
        Err(e) => Err(e),
    };
}

/// A worker's wiring and the bus.
struct Parts {
    wiring: Wiring;
    bus: Bus?;
}

fn wired(worker: Worker, words: SharedWords?, bus: Bus?) -> Parts? {
    let heard = match (Arc<AtomicU64>.create(AtomicU64.create(0))) {
        Ok(a) => a,
        Err(_) => { return null; },
    };
    let cache = match (OutputCache.create(1024, 1048576)) {
        Ok(c) => match (Arc<OutputCache>.create(c)) {
            Ok(a) => a,
            Err(_) => { return null; },
        },
        Err(_) => { return null; },
    };
    let hub = match (Hub.create()) {
        Ok(h) => match (Arc<Hub>.create(h)) {
            Ok(a) => a,
            Err(_) => { return null; },
        },
        Err(_) => { return null; },
    };
    let jobRuns = match (Arc<AtomicU64>.create(AtomicU64.create(0))) {
        Ok(a) => a,
        Err(_) => { return null; },
    };
    let jobTraps = match (Arc<AtomicU64>.create(AtomicU64.create(0))) {
        Ok(a) => a,
        Err(_) => { return null; },
    };
    var sender: BusSender? = null;
    match (bus) {
        Some(b) => {
            // Joining drops what the worker before in this place was writing when it ended; the bus's carrier
            // reads from its own `reader` in each start.
            match (b.join(worker.ring())) {
                Ok(p) => { sender = Some(p.sender()); }
                Err(_) => { return null; }
            }
        }
        null => {}
    }
    let wiring = Wiring {
        words: words,
        sender: sender,
        heard: heard,
        cache: cache,
        hub: hub,
        jobRuns: jobRuns,
        jobTraps: jobTraps,
    };
    return Some(Parts { wiring: wiring, bus: bus });
}

/// One process's server on `listener`; the status it exits with.
fn serveOn(worker: Worker, listener: borrow dyn web_transport.Incoming, words: SharedWords?, bus: Bus?) -> i32 {
    let made = wired(worker, words, bus);
    let parts = made ?? {
        Console.writeLine("bench: no memory");
        return 1;
    };
    let ears = Ears {
        heard: parts.wiring.heard.clone(),
        cache: parts.wiring.cache.clone(),
        hub: parts.wiring.hub.clone(),
    };
    let tended = match (services(worker, parts.bus, ears, borrow parts.wiring)) {
        Ok(s) => s,
        Err(_) => {
            Console.writeLine("bench: no memory");
            return 1;
        },
    };
    var app = match (application(worker.index(), parts.wiring)) {
        Ok(a) => a,
        Err(_) => {
            Console.writeLine("bench: could not build the routes");
            return 1;
        },
    };
    // The application's bound (1 000 ms by default), which `run` sets; 0 for none.
    app.bound(setting("CW_RUN_BOUND_MS", 1000));
    match (Async.run(serve(app, worker, listener, tended))) {
        Ok(_) => { return 0; }
        Err(e) => {
            Console.writeLine(NetErrors.describe(e));
            return 1;
        }
    }
}

/// The workers' server. With a listener, every worker accepts from the one socket the supervisor bound, so a
/// connection waiting to be accepted outlives a worker that ends; without, each binds its own to the shared port, and
/// the kernel gives each connection to one of them (Linux), which spreads the load evenly.
struct Bench {
    listener: SharedListener?;
    /// The counters the workers' rate limit shares (CW_SHARED=1).
    words: SharedWords?;
    /// The workers' bus (CW_BUS=1).
    bus: Bus?;
}

impl WorkerMain for Bench {
    fn run(borrow this, worker: Worker) -> i32 {
        match (borrow this.listener) {
            Some(l) => { return serveOn(worker, l, this.words, this.bus); }
            null => {}
        }
        match (listening(true)) {
            Ok(mine) => { return serveOn(worker, mine, this.words, this.bus); }
            Err(e) => {
                Console.writeLine(NetErrors.describe(e));
                return 1;
            }
        }
    }
}

/// Why the supervisor could not run, on standard output, and the end of the process.
fn failed(e: SupervisorError) -> never {
    Console.writeLine(match (e) {
        SupervisorError.BadOptions => "bench: CW_PROCS is not 1 to 256",
        SupervisorError.NoSharedMemory => "bench: no shared memory",
        SupervisorError.CannotHand => "bench: the workers cannot be handed what they share",
        SupervisorError.NotHanded => "bench: this worker was not handed what it shares",
        SupervisorError.CannotListen => "bench: cannot listen on CW_PORT",
        SupervisorError.CannotStart => "bench: cannot start a worker",
        SupervisorError.CannotWatch => "bench: the supervisor could not run",
    });
    Process.exit(1);
}

fn main() {
    let procs = setting("CW_PROCS", 0);
    if (procs == 0) {
        match (listening(setting("CW_REUSEPORT", 0) == 1)) {
            Ok(mine) => { Process.exit(serveOn(Worker.alone(), mine, null, null)); }
            Err(e) => {
                Console.writeLine(NetErrors.describe(e));
                Process.exit(1);
            }
        }
    }
    var options = SupervisorOptions.defaults(truncate<u32>(procs));
    options.stallMs = setting("CW_STALL_MS", 2000);
    options.graceMs = 3000;
    options.memoryBytes = setting("CW_MEMORY_MB", 0) * 1048576;
    options.recycleCrashes = setting("CW_RECYCLE_CRASHES", 100);
    // This program runs again in each worker, which makes the same calls in the same order and is handed what the
    // parent made.
    var supervisor = match (Supervisor.create(options)) {
        Ok(s) => s,
        Err(e) => { failed(e); },
    };
    if (supervisor.worker().isNull()) {
        Console.writeLine("bench: supervising");
    }
    var bench = Bench { listener: null, words: null, bus: null };
    if (setting("CW_BUS", 0) == 1) {
        match (supervisor.bus(65536)) {
            Ok(b) => { bench.bus = Some(b); }
            Err(e) => { failed(e); }
        }
    }
    if (setting("CW_SHARED", 0) == 1) {
        match (supervisor.words(4096)) {
            Ok(w) => { bench.words = Some(w); }
            Err(e) => { failed(e); }
        }
    }
    // The supervisor binds the port and the workers accept from its socket (the default, CW_INHERIT=1): a worker
    // that drains leaves its queue to the others. CW_INHERIT=0: each binds the shared port (SO_REUSEPORT).
    if (setting("CW_INHERIT", 1) == 1) {
        let shared = ListenOptions { backlog: 0, reuseAddress: true, reusePort: false, v6Only: false };
        match (supervisor.listener(address(), shared)) {
            Ok(l) => { bench.listener = Some(l); }
            Err(e) => { failed(e); }
        }
    }
    match (supervisor.run(bench)) {
        Ok(report) => {
            Console.writeLine("bench: started, crashed, stalled, killed");
            Console.writeLine(report.started);
            Console.writeLine(report.crashed);
            Console.writeLine(report.stalled);
            Console.writeLine(report.killed);
            Console.writeLine("bench: recycled");
            Console.writeLine(report.recycled);
        }
        Err(e) => { failed(e); }
    }
}
