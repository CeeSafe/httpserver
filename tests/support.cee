// Helpers for the tests: a state, handlers that name themselves, middleware that records its order, and one mock
// connection served by HTTP/1.1's driver.
import web_core;
import web_transport;
import web_http;
import web_http1;

/// The test application's state.
struct St {
    /// Each `before` appends its id as a decimal digit.
    befores: AtomicU64;
}

fn state() -> St => St { befores: AtomicU64.create(0) };

fn alloc<T>(r: Result<T, AllocError>) -> Result<T, TestFailure> {
    match (r) {
        Ok(v) => { return Ok(v); }
        Err(_) => { return Err(TestFailure.create("out of memory")); }
    }
}

fn routed<T>(r: Result<T, RouteError>) -> Result<T, TestFailure> {
    match (r) {
        Ok(v) => { return Ok(v); }
        Err(_) => { return Err(TestFailure.create("a route error")); }
    }
}

/// Answers `h<id>`.
struct Named {
    id: u32;
}

impl Handler<St> for Named {
    async fn handle(
        borrow this,
        ctx: borrow mut Context<St>,
        request: borrow Request,
        exchange: borrow mut Exchange,
    ) -> Result<void, HandlerError> {
        var b = [104u8, 0u8];
        b[1] = truncate<u8>(48 + this.id % 10);
        return await exchange.send(Status.ok(), b[..]);
    }
}

fn named(id: u32) -> Result<Box<dyn Handler<St> + Send + Share>, TestFailure> {
    let h: Box<dyn Handler<St> + Send + Share> = alloc(Box.create(Named { id: id }))?;
    return Ok(h);
}

/// Answers `<id>|<rest>|<q>`: the parameters `id` (decoded) and `rest` (as sent), and the query's `q` (decoded).
struct Shown {}

impl Handler<St> for Shown {
    async fn handle(
        borrow this,
        ctx: borrow mut Context<St>,
        request: borrow Request,
        exchange: borrow mut Exchange,
    ) -> Result<void, HandlerError> {
        var id = Vector<u8>.create();
        if (!ctx.paramDecoded("id", mut id)) {
            id.clear();
        }
        let rest = match (ctx.param("rest")) {
            Some(v) => v.bytes(),
            null => "".bytes(),
        };
        var q = Vector<u8>.create();
        if (!Query.value(request.query(), "q", mut q)) {
            q.clear();
        }
        exchange.setContentLength((id.length + 2 + rest.length + q.length) as u64);
        await exchange.write(id.view())?;
        await exchange.write("|".bytes())?;
        await exchange.write(rest)?;
        await exchange.write("|".bytes())?;
        await exchange.write(q.view())?;
        return Ok();
    }
}

fn shown() -> Result<Box<dyn Handler<St> + Send + Share>, TestFailure> {
    let h: Box<dyn Handler<St> + Send + Share> = alloc(Box.create(Shown {}))?;
    return Ok(h);
}

/// Records its `before` in the state, sets `x-b<id>: 1` in `before` and `x-a<id>: 1` in `after`, and answers 401
/// itself when the request has `x-deny: <id>`.
struct Mark {
    id: u32;
}

fn fieldName(letter: u8, id: u32, out: borrow mut [u8; 4]) {
    out[0] = 120;
    out[1] = 45;
    out[2] = letter;
    out[3] = truncate<u8>(48 + id % 10);
}

impl Middleware<St> for Mark {
    async fn before(
        borrow this,
        ctx: borrow mut Context<St>,
        request: borrow Request,
        exchange: borrow mut Exchange,
    ) -> Result<Flow, HandlerError> {
        let s = ctx.state();
        s.befores.store(s.befores.load() * 10 + this.id as u64);
        var name = [0u8; 4];
        fieldName(98, this.id, mut name);
        let text = StringView.fromUtf8(name[..]) ?? { return Err(HandlerError.Internal); };
        exchange.header(text, "1".bytes())?;
        let deny = match (request.headers().getNamed("x-deny")) {
            Some(v) => v.length == 1 && v[0] == name[3],
            null => false,
        };
        if (deny) {
            let status = StatusCode.of(401) ?? { return Err(HandlerError.Internal); };
            await exchange.send(status, "".bytes())?;
            return Ok(Flow.Responded);
        }
        return Ok(Flow.Continue);
    }

    async fn after(borrow this, request: borrow Request, head: borrow mut ResponseHead) -> Result<void, HandlerError> {
        var name = [0u8; 4];
        fieldName(97, this.id, mut name);
        let text = StringView.fromUtf8(name[..]) ?? { return Err(HandlerError.Internal); };
        match (head.add(text, "1".bytes())) {
            Ok() => { return Ok(); }
            Err(_) => { return Err(HandlerError.Internal); }
        }
    }
}

fn mark(id: u32) -> Result<Box<dyn Middleware<St> + Send + Share>, TestFailure> {
    let m: Box<dyn Middleware<St> + Send + Share> = alloc(Box.create(Mark { id: id }))?;
    return Ok(m);
}

/// HTTP limits without `Date`, so responses can be compared byte for byte.
fn quiet() -> Limits {
    var l = Limits.defaults();
    l.sendDate = false;
    return l;
}

/// Serves `text` on one mock connection with `app` and returns what was written.
async fn served(app: borrow App<St>, text: StringView) -> Result<Vector<u8>, TestFailure> {
    var conn = match (MockTransport.create(text.bytes())) {
        Ok(m) => m,
        Err(_) => { return Err(TestFailure.create("a mock")); },
    };
    let drain = match (Drain.create()) {
        Ok(d) => d,
        Err(_) => { return Err(TestFailure.create("a drain")); },
    };
    let ctx = ConnectionContext.acceptedNow(1, drain);
    match (await web_http1.serve(mut conn, ctx, app, app.limits())) {
        Ok() => {}
        Err(e) => { return Err(TestFailure.create(NetErrors.describe(e))); }
    }
    var out = Vector<u8>.create();
    for (b in conn.written()) {
        match (out.push(b)) {
            Ok() => {}
            Err(_) => { return Err(TestFailure.create("out of memory")); }
        }
    }
    return Ok(out);
}
